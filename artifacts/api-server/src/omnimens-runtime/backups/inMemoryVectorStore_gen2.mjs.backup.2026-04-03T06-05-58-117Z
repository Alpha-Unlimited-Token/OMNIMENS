import { createHash } from 'crypto';

/**
 * Utility to create an in-memory vector store for high-dimensional embeddings.
 * Supports fast approximate nearest-neighbor search using Locality-Sensitive Hashing (LSH).
 */

// Helper function to hash a vector into an LSH bucket
export function hashVector(vector, numBuckets, hashLength = 128) {
  const hash = createHash('sha256');
  hash.update(vector.join(','));
  const fullHash = hash.digest('hex');
  const numericHash = parseInt(fullHash.slice(0, hashLength / 4), 16);
  return numericHash % numBuckets;
}

// Function to calculate Euclidean distance between two vectors
export function euclideanDistance(vectorA, vectorB) {
  if (vectorA.length !== vectorB.length) {
    throw new Error('Vectors must have the same dimensions');
  }
  return Math.sqrt(vectorA.reduce((sum, val, i) => sum + (val - vectorB[i]) ** 2, 0));
}

// Class to represent the in-memory vector store
export class InMemoryVectorStore {
  constructor(numBuckets = 100) {
    this.numBuckets = numBuckets;
    this.buckets = Array.from({ length: numBuckets }, () => []);
    this.vectors = new Map(); // Maps vector IDs to their original vectors
  }

  // Add a vector to the store
  addVector(id, vector) {
    if (this.vectors.has(id)) {
      throw new Error(`Vector with ID '${id}' already exists`);
    }
    const bucketIndex = hashVector(vector, this.numBuckets);
    this.buckets[bucketIndex].push({ id, vector });
    this.vectors.set(id, vector);
  }

  // Search for the nearest neighbors to a query vector
  search(queryVector, k = 1) {
    const bucketIndex = hashVector(queryVector, this.numBuckets);
    const candidates = this.buckets[bucketIndex];

    if (candidates.length === 0) {
      return [];
    }

    const distances = candidates.map(({ id, vector }) => ({
      id,
      distance: euclideanDistance(queryVector, vector)
    }));

    distances.sort((a, b) => a.distance - b.distance);

    return distances.slice(0, k);
  }

  // Retrieve a vector by its ID
  getVector(id) {
    return this.vectors.get(id) || null;
  }

  // Remove a vector by its ID
  removeVector(id) {
    const vector = this.vectors.get(id);
    if (!vector) {
      throw new Error(`Vector with ID '${id}' not found`);
    }
    const bucketIndex = hashVector(vector, this.numBuckets);
    this.buckets[bucketIndex] = this.buckets[bucketIndex].filter(item => item.id !== id);
    this.vectors.delete(id);
  }
}

// Example utility function for cosine similarity (optional, for other use cases)
export function cosineSimilarity(vectorA, vectorB) {
  if (vectorA.length !== vectorB.length) {
    throw new Error('Vectors must have the same dimensions');
  }
  const dotProduct = vectorA.reduce((sum, val, i) => sum + val * vectorB[i], 0);
  const magnitudeA = Math.sqrt(vectorA.reduce((sum, val) => sum + val ** 2, 0));
  const magnitudeB = Math.sqrt(vectorB.reduce((sum, val) => sum + val ** 2, 0));
  return dotProduct / (magnitudeA * magnitudeB);
}
