function findPatternsInText(text, patterns) {
    if (typeof text !== 'string' || !Array.isArray(patterns)) {
        throw new Error('Invalid input: text must be a string and patterns must be an array of strings.');
    }

    const results = {};
    patterns.forEach((pattern) => {
        if (typeof pattern !== 'string') {
            throw new Error('Invalid pattern: all patterns must be strings.');
        }
        const regex = new RegExp(pattern, 'g');
        const matches = text.match(regex);
        results[pattern] = matches ? matches.length : 0;
    });

    return results;
}

// Self-tests
function runTests() {
    console.log('Running tests...');

    const text = "The quick brown fox jumps over the lazy dog. The dog barked at the fox.";
    const patterns = ["fox", "dog", "quick", "cat"];

    // Test 1: Basic pattern matching
    const result1 = findPatternsInText(text, patterns);
    console.log(result1); // Expected: { fox: 2, dog: 2, quick: 1, cat: 0 }

    // Test 2: Empty text
    const result2 = findPatternsInText("", patterns);
    console.log(result2); // Expected: { fox: 0, dog: 0, quick: 0, cat: 0 }

    // Test 3: Empty patterns
    const result3 = findPatternsInText(text, []);
    console.log(result3); // Expected: {}

    // Test 4: Edge case - patterns with special regex characters
    const specialPatterns = ["\\bfox\\b", "\\bdog\\b", "\\bquick\\b"];
    const result4 = findPatternsInText(text, specialPatterns);
    console.log(result4); // Expected: { "\\bfox\\b": 2, "\\bdog\\b": 2, "\\bquick\\b": 1 }

    // Test 5: Invalid inputs
    try {
        findPatternsInText(123, patterns);
    } catch (error) {
        console.log(error.message); // Expected: 'Invalid input: text must be a string and patterns must be an array of strings.'
    }

    try {
        findPatternsInText(text, "fox");
    } catch (error) {
        console.log(error.message); // Expected: 'Invalid input: text must be a string and patterns must be an array of strings.'
    }

    try {
        findPatternsInText(text, [123]);
    } catch (error) {
        console.log(error.message); // Expected: 'Invalid pattern: all patterns must be strings.'
    }

    console.log('Tests completed.');
}

runTests();