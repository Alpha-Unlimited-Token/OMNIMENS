function findLongestCommonSubstring(str1, str2) {
    if (!str1 || !str2 || typeof str1 !== 'string' || typeof str2 !== 'string') {
        throw new Error('Both inputs must be non-empty strings');
    }

    const len1 = str1.length;
    const len2 = str2.length;
    const dp = Array(len1 + 1).fill(null).map(() => Array(len2 + 1).fill(0));
    let maxLength = 0;
    let endIndexStr1 = 0;

    for (let i = 1; i <= len1; i++) {
        for (let j = 1; j <= len2; j++) {
            if (str1[i - 1] === str2[j - 1]) {
                dp[i][j] = dp[i - 1][j - 1] + 1;
                if (dp[i][j] > maxLength) {
                    maxLength = dp[i][j];
                    endIndexStr1 = i - 1;
                }
            }
        }
    }

    return str1.slice(endIndexStr1 - maxLength + 1, endIndexStr1 + 1);
}

// Test cases
try {
    console.log(findLongestCommonSubstring("abcdef", "zcdemf")); // Output: "cde"
    console.log(findLongestCommonSubstring("12345", "54321")); // Output: "3"
    console.log(findLongestCommonSubstring("hello", "world")); // Output: "o"
    console.log(findLongestCommonSubstring("abcdxyz", "xyzabcd")); // Output: "abcd"
    console.log(findLongestCommonSubstring("same", "same")); // Output: "same"
    console.log(findLongestCommonSubstring("", "nonempty")); // Throws Error
    console.log(findLongestCommonSubstring("nonempty", "")); // Throws Error
    console.log(findLongestCommonSubstring("", "")); // Throws Error
    console.log(findLongestCommonSubstring(123, "abc")); // Throws Error
    console.log(findLongestCommonSubstring("abc", 123)); // Throws Error
} catch (e) {
    console.log(e.message);
}