function findMostFrequentPatterns(text, minLength, maxLength, topN) {
    if (typeof text !== 'string' || text.length === 0) {
        throw new Error('Input text must be a non-empty string.');
    }
    if (minLength < 1 || maxLength < minLength || topN < 1) {
        throw new Error('Invalid parameters: ensure minLength >= 1, maxLength >= minLength, and topN >= 1.');
    }

    const patternCounts = new Map();

    for (let length = minLength; length <= maxLength; length++) {
        for (let i = 0; i <= text.length - length; i++) {
            const pattern = text.substring(i, i + length);
            patternCounts.set(pattern, (patternCounts.get(pattern) || 0) + 1);
        }
    }

    const sortedPatterns = Array.from(patternCounts.entries())
        .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
        .slice(0, topN);

    return sortedPatterns.map(([pattern, count]) => ({ pattern, count }));
}

