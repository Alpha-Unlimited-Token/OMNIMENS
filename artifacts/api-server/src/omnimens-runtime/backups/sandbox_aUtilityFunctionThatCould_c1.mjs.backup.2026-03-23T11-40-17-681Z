function findPatternsInText(text, patterns) {
    const results = [];
    patterns.forEach(pattern => {
        const regex = new RegExp(pattern, 'g');
        const matches = [];
        let match;
        while ((match = regex.exec(text)) !== null) {
            matches.push({ match: match[0], index: match.index });
        }
        results.push({ pattern, matches });
    });
    return results;
}

// Test cases
const testText = "The quick brown fox jumps over the lazy dog. The fox is clever.";
const testPatterns = ["fox", "the", "lazy", "clever"];

const results = findPatternsInText(testText, testPatterns);
console.log("Test Results:", JSON.stringify(results, null, 2));

// Edge case: Empty text
const emptyTextResults = findPatternsInText("", testPatterns);
console.log("Empty Text Results:", JSON.stringify(emptyTextResults, null, 2));

// Edge case: No matching patterns
const noMatchResults = findPatternsInText(testText, ["cat", "mouse"]);
console.log("No Match Results:", JSON.stringify(noMatchResults, null, 2));

// Edge case: Empty patterns array
const emptyPatternsResults = findPatternsInText(testText, []);
console.log("Empty Patterns Results:", JSON.stringify(emptyPatternsResults, null, 2));