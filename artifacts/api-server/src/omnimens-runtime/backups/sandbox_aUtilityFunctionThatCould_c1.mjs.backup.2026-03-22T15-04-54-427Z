// Utility function to extract and count unique words from a given text, ignoring case and punctuation.
function extractAndCountUniqueWords(text) {
    if (typeof text !== 'string') {
        throw new Error('Input must be a string');
    }

    // Remove punctuation and convert to lowercase
    const cleanedText = text.replace(/[^\w\s]/g, '').toLowerCase();

    // Split text into words
    const words = cleanedText.split(/\s+/).filter(word => word.length > 0);

    // Count unique words
    const wordCounts = {};
    for (const word of words) {
        wordCounts[word] = (wordCounts[word] || 0) + 1;
    }

    return wordCounts;
}

// Test cases
function runTests() {
    console.log("Running tests...");

    // Test 1: Basic functionality
    const text1 = "Hello, world! Hello again.";
    const result1 = extractAndCountUniqueWords(text1);
    console.log(result1); // { hello: 2, world: 1, again: 1 }

    // Test 2: Case insensitivity
    const text2 = "Case CASE case.";
    const result2 = extractAndCountUniqueWords(text2);
    console.log(result2); // { case: 3 }

    // Test 3: Punctuation handling
    const text3 = "Punctuation! Shouldn't, affect: the; result.";
    const result3 = extractAndCountUniqueWords(text3);
    console.log(result3); // { punctuation: 1, shouldnt: 1, affect: 1, the: 1, result: 1 }

    // Test 4: Empty string
    const text4 = "";
    const result4 = extractAndCountUniqueWords(text4);
    console.log(result4); // {}

    // Test 5: Numbers and mixed content
    const text5 = "123 123 test TEST 456.";
    const result5 = extractAndCountUniqueWords(text5);
    console.log(result5); // { '123': 2, test: 2, '456': 1 }

    console.log("All tests completed.");
}

// Run the tests
runTests();