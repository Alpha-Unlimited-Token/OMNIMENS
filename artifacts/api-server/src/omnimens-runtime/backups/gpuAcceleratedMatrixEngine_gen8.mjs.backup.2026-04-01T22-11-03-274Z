// gpuAcceleratedMatrixEngine.mjs

import { createHash } from 'crypto';

/**
 * Generate unique identifiers for matrix operations to cache results.
 * @param {Array} matrixA - First matrix.
 * @param {Array} matrixB - Second matrix.
 * @returns {string} - Unique hash identifier.
 */
export function generateMatrixHash(matrixA, matrixB) {
  const hash = createHash('sha256');
  hash.update(JSON.stringify(matrixA));
  hash.update(JSON.stringify(matrixB));
  return hash.digest('hex');
}

/**
 * Multiply two matrices using pure JavaScript for fallback.
 * @param {Array} matrixA - First matrix.
 * @param {Array} matrixB - Second matrix.
 * @returns {Array} - Resultant matrix.
 */
export function multiplyMatrices(matrixA, matrixB) {
  const rowsA = matrixA.length;
  const colsA = matrixA[0].length;
  const rowsB = matrixB.length;
  const colsB = matrixB[0].length;

  if (colsA !== rowsB) {
    throw new Error('Matrix dimensions do not match for multiplication.');
  }

  const result = Array.from({ length: rowsA }, () => Array(colsB).fill(0));

  for (let i = 0; i < rowsA; i++) {
    for (let j = 0; j < colsB; j++) {
      for (let k = 0; k < colsA; k++) {
        result[i][j] += matrixA[i][k] * matrixB[k][j];
      }
    }
  }

  return result;
}

/**
 * Compute eigenvalues of a square matrix using a naive iterative algorithm.
 * @param {Array} matrix - Square matrix.
 * @returns {Array} - Eigenvalues.
 */
export function computeEigenvalues(matrix) {
  const size = matrix.length;
  if (!matrix.every(row => row.length === size)) {
    throw new Error('Matrix must be square to compute eigenvalues.');
  }

  // Naive iterative method for eigenvalue approximation (simplified for demonstration).
  const eigenvalues = [];
  const tolerance = 1e-6;

  for (let i = 0; i < size; i++) {
    let lambda = matrix[i][i];
    let diff;

    do {
      diff = 0;
      for (let j = 0; j < size; j++) {
        if (i !== j) {
          diff += Math.abs(matrix[i][j]);
        }
      }
      lambda -= diff;
    } while (diff > tolerance);

    eigenvalues.push(lambda);
  }

  return eigenvalues;
}

/**
 * Normalize a matrix such that its values range between 0 and 1.
 * @param {Array} matrix - Input matrix.
 * @returns {Array} - Normalized matrix.
 */
export function normalizeMatrix(matrix) {
  const flattened = matrix.flat();
  const min = Math.min(...flattened);
  const max = Math.max(...flattened);

  if (min === max) {
    throw new Error('Matrix cannot be normalized (all values are identical).');
  }

  return matrix.map(row => row.map(value => (value - min) / (max - min)));
}

/**
 * Transpose a matrix.
 * @param {Array} matrix - Input matrix.
 * @returns {Array} - Transposed matrix.
 */
export function transposeMatrix(matrix) {
  const rows = matrix.length;
  const cols = matrix[0].length;

  const result = Array.from({ length: cols }, () => Array(rows).fill(0));

  for (let i = 0; i < rows; i++) {
    for (let j = 0; j < cols; j++) {
      result[j][i] = matrix[i][j];
    }
  }

  return result;
}

/**
 * Validate matrix dimensions for operations.
 * @param {Array} matrix - Input matrix.
 * @returns {boolean} - True if valid, false otherwise.
 */
export function validateMatrix(matrix) {
  if (!Array.isArray(matrix) || !Array.isArray(matrix[0])) {
    return false;
  }
  const cols = matrix[0].length;
  return matrix.every(row => row.length === cols);
}