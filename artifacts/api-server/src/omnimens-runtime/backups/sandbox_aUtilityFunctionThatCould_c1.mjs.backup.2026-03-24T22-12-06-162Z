function extractKeywords(text, stopWords) {
    // Function to extract keywords from a given text, excluding stop words
    function isStopWord(word) {
        return stopWords.has(word.toLowerCase());
    }

    function cleanWord(word) {
        return word.replace(/[^a-zA-Z0-9]/g, '').toLowerCase();
    }

    const words = text.split(/\s+/);
    const keywordMap = new Map();

    for (let word of words) {
        const cleanedWord = cleanWord(word);
        if (cleanedWord && !isStopWord(cleanedWord)) {
            keywordMap.set(cleanedWord, (keywordMap.get(cleanedWord) || 0) + 1);
        }
    }

    return Array.from(keywordMap.entries())
        .sort((a, b) => b[1] - a[1]) // Sort by frequency
        .map(entry => ({ keyword: entry[0], frequency: entry[1] }));
}

