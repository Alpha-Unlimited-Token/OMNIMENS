// Utility function for text analysis: Word Frequency Counter
// This function calculates the frequency of each word in a given string,
// ignoring case and punctuation, and returns the result as an object.

function wordFrequencyCounter(text) {
    if (typeof text !== 'string') {
        throw new Error('Input must be a string');
    }

    // Remove punctuation and convert to lowercase
    const sanitizedText = text.replace(/[^\w\s]/g, '').toLowerCase();

    // Split the text into words and filter out empty strings
    const words = sanitizedText.split(/\s+/).filter(word => word.length > 0);

    // Count the frequency of each word
    const frequency = {};
    for (let word of words) {
        frequency[word] = (frequency[word] || 0) + 1;
    }

    return frequency;
}

