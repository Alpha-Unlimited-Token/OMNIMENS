const AssociativeMemory = function() {
    this.memory = new Map();
};

AssociativeMemory.prototype.add = function(key, value) {
    if (!this.memory.has(key)) {
        this.memory.set(key, []);
    }
    this.memory.get(key).push(value);
};

AssociativeMemory.prototype.get = function(key) {
    return this.memory.has(key) ? this.memory.get(key) : null;
};

AssociativeMemory.prototype.remove = function(key, value) {
    if (this.memory.has(key)) {
        const values = this.memory.get(key);
        const index = values.indexOf(value);
        if (index !== -1) {
            values.splice(index, 1);
            if (values.length === 0) {
                this.memory.delete(key);
            }
        }
    }
};

AssociativeMemory.prototype.clear = function() {
    this.memory.clear();
};

// Test cases
const memory = new AssociativeMemory();

// Add data
memory.add("Innovator", "Integrate evolutionary algorithms with cognitive modeling");
memory.add("Archivist", "Integrate insights from Critic's adversarial testing");
memory.add("Visionary", "Imagine a decentralized trust system using blockchain");
memory.add("Pioneer", "Explore the intersection of neuroplasticity and AI model training");
memory.add("Ethicist", "Integrate ethical audits into security");

// Lookup data
console.log(memory.get("Innovator")); // ["Integrate evolutionary algorithms with cognitive modeling"]
console.log(memory.get("Archivist")); // ["Integrate insights from Critic's adversarial testing"]
console.log(memory.get("Visionary")); // ["Imagine a decentralized trust system using blockchain"]
console.log(memory.get("Pioneer")); // ["Explore the intersection of neuroplasticity and AI model training"]
console.log(memory.get("Ethicist")); // ["Integrate ethical audits into security"]

// Remove data
memory.remove("Innovator", "Integrate evolutionary algorithms with cognitive modeling");
console.log(memory.get("Innovator")); // null

// Add multiple values to the same key
memory.add("Archivist", "Enhance long-term memory synthesis");
console.log(memory.get("Archivist")); // ["Integrate insights from Critic's adversarial testing", "Enhance long-term memory synthesis"]

// Remove one value from a key with multiple values
memory.remove("Archivist", "Integrate insights from Critic's adversarial testing");
console.log(memory.get("Archivist")); // ["Enhance long-term memory synthesis"]

// Clear all memory
memory.clear();
console.log(memory.get("Visionary")); // null
console.log(memory.get("Pioneer")); // null