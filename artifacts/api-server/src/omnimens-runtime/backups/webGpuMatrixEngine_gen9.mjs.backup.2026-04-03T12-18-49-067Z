import { performance } from 'perf_hooks';

// Utility to create a GPU-compatible matrix
export function createMatrix(rows, cols, fillValue = 0) {
  return Array.from({ length: rows }, () => Array(cols).fill(fillValue));
}

// Matrix multiplication using pure JavaScript (fallback if GPU unavailable)
export function multiplyMatricesCPU(matrixA, matrixB) {
  const rowsA = matrixA.length;
  const colsA = matrixA[0].length;
  const rowsB = matrixB.length;
  const colsB = matrixB[0].length;

  if (colsA !== rowsB) {
    throw new Error('Matrix dimensions do not match for multiplication');
  }

  const result = createMatrix(rowsA, colsB);
  for (let i = 0; i < rowsA; i++) {
    for (let j = 0; j < colsB; j++) {
      for (let k = 0; k < colsA; k++) {
        result[i][j] += matrixA[i][k] * matrixB[k][j];
      }
    }
  }
  return result;
}

// Simulated GPU matrix multiplication (mock implementation for Node.js)
export function multiplyMatricesGPU(matrixA, matrixB) {
  const start = performance.now();
  const result = multiplyMatricesCPU(matrixA, matrixB); // Mock GPU acceleration
  const end = performance.now();
  console.log(`Simulated GPU matrix multiplication took ${(end - start).toFixed(2)}ms`);
  return result;
}

// Eigenvalue decomposition (basic power iteration method)
export function eigenDecomposition(matrix, maxIterations = 1000, tolerance = 1e-10) {
  const size = matrix.length;
  if (matrix.some(row => row.length !== size)) {
    throw new Error('Matrix must be square for eigenvalue decomposition');
  }

  let eigenvector = Array(size).fill(1);
  let eigenvalue = 0;

  for (let iter = 0; iter < maxIterations; iter++) {
    const nextVector = multiplyMatricesCPU([eigenvector], matrix)[0];
    const norm = Math.sqrt(nextVector.reduce((sum, val) => sum + val * val, 0));

    eigenvector = nextVector.map(val => val / norm);
    const nextEigenvalue = multiplyMatricesCPU([eigenvector], matrix)[0].reduce((sum, val, i) => sum + val * eigenvector[i], 0);

    if (Math.abs(nextEigenvalue - eigenvalue) < tolerance) {
      break;
    }
    eigenvalue = nextEigenvalue;
  }

  return { eigenvalue, eigenvector };
}

// Hopfield network update rule (synchronous)
export function hopfieldUpdate(weights, state) {
  if (weights.length !== state.length || weights.some(row => row.length !== state.length)) {
    throw new Error('Weights matrix and state vector dimensions must match');
  }

  return state.map((_, i) => {
    const sum = weights[i].reduce((acc, weight, j) => acc + weight * state[j], 0);
    return sum >= 0 ? 1 : -1;
  });
}

// Example function to demonstrate usage
export function demo() {
  const matrixA = createMatrix(3, 2, 1);
  const matrixB = createMatrix(2, 3, 2);
  const product = multiplyMatricesGPU(matrixA, matrixB);

  const squareMatrix = [
    [4, 1],
    [2, 3]
  ];
  const { eigenvalue, eigenvector } = eigenDecomposition(squareMatrix);

  const weights = [
    [0, 1, -1],
    [1, 0, 1],
    [-1, 1, 0]
  ];
  const state = [1, -1, 1];
  const updatedState = hopfieldUpdate(weights, state);

  return { product, eigenvalue, eigenvector, updatedState };
}