function findCausalRelationships(data, causeKey, effectKey) {
    const relationships = [];

    for (let i = 0; i < data.length; i++) {
        const cause = data[i][causeKey];
        const effect = data[i][effectKey];

        if (cause && effect) {
            relationships.push({ cause, effect });
        }
    }

    return relationships;
}

// Test cases
function testFindCausalRelationships() {
    const testData = [
        { cause: "Rain", effect: "Wet ground" },
        { cause: "Sun", effect: "Dry ground" },
        { cause: "Wind", effect: "Fallen leaves" },
        { cause: null, effect: "Unknown" },
        { cause: "Snow", effect: null },
    ];

    const result = findCausalRelationships(testData, "cause", "effect");
    console.log("Test Case 1:", result);

    const expected = [
        { cause: "Rain", effect: "Wet ground" },
        { cause: "Sun", effect: "Dry ground" },
        { cause: "Wind", effect: "Fallen leaves" },
    ];

    console.log("Test Case 1 Passed:", JSON.stringify(result) === JSON.stringify(expected));

    // Edge case: Empty data
    const emptyData = [];
    const emptyResult = findCausalRelationships(emptyData, "cause", "effect");
    console.log("Test Case 2:", emptyResult);
    console.log("Test Case 2 Passed:", JSON.stringify(emptyResult) === JSON.stringify([]));

    // Edge case: Missing keys
    const missingKeysData = [
        { action: "Rain", result: "Wet ground" },
        { action: "Sun", result: "Dry ground" },
    ];
    const missingKeysResult = findCausalRelationships(missingKeysData, "cause", "effect");
    console.log("Test Case 3:", missingKeysResult);
    console.log("Test Case 3 Passed:", JSON.stringify(missingKeysResult) === JSON.stringify([]));
}

testFindCausalRelationships();