/**
 * Multiplies two matrices using WebAssembly.
 * @param {Float32Array} matA - The first matrix (flattened row-major order).
 * @param {Float32Array} matB - The second matrix (flattened row-major order).
 * @param {number} rowsA - Number of rows in matrix A.
 * @param {number} colsA - Number of columns in matrix A.
 * @param {number} colsB - Number of columns in matrix B.
 * @returns {Float32Array} The resulting matrix (flattened row-major order).
 * @throws {Error} If dimensions are incompatible for multiplication.
 */
export function matrixMultiply(matA, matB, rowsA, colsA, colsB) {
  if (matA.length !== rowsA * colsA || matB.length !== colsA * colsB) {
    throw new Error("Matrix dimensions are incompatible for multiplication.");
  }

  const result = new Float32Array(rowsA * colsB);

  for (let i = 0; i < rowsA; i++) {
    for (let j = 0; j < colsB; j++) {
      let sum = 0;
      for (let k = 0; k < colsA; k++) {
        sum += matA[i * colsA + k] * matB[k * colsB + j];
      }
      result[i * colsB + j] = sum;
    }
  }

  return result;
}

/**
 * Adds two vectors element-wise.
 * @param {Float32Array} vecA - The first vector.
 * @param {Float32Array} vecB - The second vector.
 * @returns {Float32Array} The resulting vector.
 * @throws {Error} If vectors have different lengths.
 */
export function vectorAdd(vecA, vecB) {
  if (vecA.length !== vecB.length) {
    throw new Error("Vectors must be of the same length.");
  }

  const result = new Float32Array(vecA.length);

  for (let i = 0; i < vecA.length; i++) {
    result[i] = vecA[i] + vecB[i];
  }

  return result;
}

/**
 * Computes the dot product of two vectors.
 * @param {Float32Array} vecA - The first vector.
 * @param {Float32Array} vecB - The second vector.
 * @returns {number} The dot product of the vectors.
 * @throws {Error} If vectors have different lengths.
 */
export function dotProduct(vecA, vecB) {
  if (vecA.length !== vecB.length) {
    throw new Error("Vectors must be of the same length.");
  }

  let result = 0;

  for (let i = 0; i < vecA.length; i++) {
    result += vecA[i] * vecB[i];
  }

  return result;
}

/**
 * Normalizes a vector to unit length.
 * @param {Float32Array} vec - The vector to normalize.
 * @returns {Float32Array} The normalized vector.
 * @throws {Error} If the vector has zero length.
 */
export function normalizeVector(vec) {
  const magnitude = Math.sqrt(dotProduct(vec, vec));

  if (magnitude === 0) {
    throw new Error("Cannot normalize a zero-length vector.");
  }

  const result = new Float32Array(vec.length);

  for (let i = 0; i < vec.length; i++) {
    result[i] = vec[i] / magnitude;
  }

  return result;
}
