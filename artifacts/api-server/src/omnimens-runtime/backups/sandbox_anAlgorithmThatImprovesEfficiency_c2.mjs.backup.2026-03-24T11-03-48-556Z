function createKnowledgeGraph() {
    const graph = new Map();

    function addConcept(concept, relatedConcepts = []) {
        if (!graph.has(concept)) {
            graph.set(concept, new Set());
        }
        relatedConcepts.forEach((related) => {
            if (!graph.has(related)) {
                graph.set(related, new Set());
            }
            graph.get(concept).add(related);
            graph.get(related).add(concept); // bidirectional relationship
        });
    }

    function findShortestPath(start, end) {
        if (!graph.has(start) || !graph.has(end)) return null;

        const visited = new Set();
        const queue = [[start, [start]]];

        while (queue.length > 0) {
            const [current, path] = queue.shift();

            if (current === end) {
                return path;
            }

            visited.add(current);

            for (const neighbor of graph.get(current)) {
                if (!visited.has(neighbor)) {
                    queue.push([neighbor, [...path, neighbor]]);
                }
            }
        }
        return null; // no path found
    }

    function findRelatedConcepts(concept, depth = 1) {
        if (!graph.has(concept)) return [];

        const visited = new Set();
        const result = new Set();
        let currentLevel = [concept];
        visited.add(concept);

        for (let i = 0; i < depth; i++) {
            const nextLevel = [];
            for (const node of currentLevel) {
                for (const neighbor of graph.get(node)) {
                    if (!visited.has(neighbor)) {
                        visited.add(neighbor);
                        result.add(neighbor);
                        nextLevel.push(neighbor);
                    }
                }
            }
            currentLevel = nextLevel;
        }

        return Array.from(result);
    }

    return {
        addConcept,
        findShortestPath,
        findRelatedConcepts
    };
}

// Self-tests
const knowledgeGraph = createKnowledgeGraph();

// Adding concepts and relationships
knowledgeGraph.addConcept("recursion", ["autopoiesis", "emergence"]);
knowledgeGraph.addConcept("autopoiesis", ["self-organization"]);
knowledgeGraph.addConcept("emergence", ["complexity"]);
knowledgeGraph.addConcept("self-organization", ["complexity", "adaptation"]);
knowledgeGraph.addConcept("adaptation", ["learning"]);
knowledgeGraph.addConcept("learning", ["intelligence"]);

// Test 1: Find shortest path
console.log(
    "Shortest Path (recursion -> intelligence):",
    knowledgeGraph.findShortestPath("recursion", "intelligence")
); // Expected: ["recursion", "autopoiesis", "self-organization", "adaptation", "learning", "intelligence"]

// Test 2: Find related concepts within depth
console.log(
    "Related Concepts (recursion, depth 2):",
    knowledgeGraph.findRelatedConcepts("recursion", 2)
); // Expected: ["autopoiesis", "emergence", "self-organization", "complexity"]

// Test 3: Edge case - No path
console.log(
    "Shortest Path (recursion -> unknown):",
    knowledgeGraph.findShortestPath("recursion", "unknown")
); // Expected: null

// Test 4: Edge case - Non-existent concept
console.log(
    "Related Concepts (unknown, depth 2):",
    knowledgeGraph.findRelatedConcepts("unknown", 2)
); // Expected: []