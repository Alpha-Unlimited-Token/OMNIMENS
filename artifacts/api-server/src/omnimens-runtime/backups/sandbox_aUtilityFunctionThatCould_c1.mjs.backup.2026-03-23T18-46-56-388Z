function extractKeywords(text, minLength = 3) {
    const stopWords = new Set([
        "the", "is", "in", "at", "of", "on", "and", "a", "to", "it", "this", "that", "with", "for", "as", "was", "by", "an", "be", "or", "from", "are", "but", "not", "have", "has", "had", "which", "were", "can", "will", "would", "could", "should", "may", "might", "must", "do", "does", "did", "so", "if", "then", "than", "such", "like", "about", "into", "out", "up", "down", "over", "under", "these", "those", "their", "there", "here", "how", "what", "why", "when", "where", "who", "whom", "whose", "some", "any", "each", "every", "either", "neither", "both", "few", "many", "more", "most", "other", "another", "same", "different", "again", "always", "never", "sometimes", "often", "once", "all", "no", "yes", "yet", "still", "just"
    ]);

    function cleanWord(word) {
        return word.toLowerCase().replace(/[^a-z0-9]/g, "");
    }

    const words = text.split(/\s+/);
    const keywordCount = {};

    for (let word of words) {
        const cleanedWord = cleanWord(word);
        if (cleanedWord.length >= minLength && !stopWords.has(cleanedWord)) {
            keywordCount[cleanedWord] = (keywordCount[cleanedWord] || 0) + 1;
        }
    }

    const sortedKeywords = Object.entries(keywordCount)
        .sort((a, b) => b[1] - a[1])
        .map(entry => ({ keyword: entry[0], count: entry[1] }));

    return sortedKeywords;
}

