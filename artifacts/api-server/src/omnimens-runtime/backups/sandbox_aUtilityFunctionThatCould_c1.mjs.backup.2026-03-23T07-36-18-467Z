function findPatternsInText(text, patterns) {
    if (typeof text !== 'string' || !Array.isArray(patterns)) {
        throw new Error("Invalid input: 'text' must be a string and 'patterns' must be an array of strings.");
    }

    const results = patterns.map(pattern => {
        if (typeof pattern !== 'string') {
            throw new Error("Invalid pattern: all patterns must be strings.");
        }
        const regex = new RegExp(pattern, 'g');
        const matches = [...text.matchAll(regex)];
        return {
            pattern,
            count: matches.length,
            matches: matches.map(match => match[0]),
            positions: matches.map(match => match.index)
        };
    });

    return results;
}

// Test cases
function runTests() {
    console.log("Running tests...");

    const text = "The quick brown fox jumps over the lazy dog. The fox is clever.";
    const patterns = ["fox", "The", "dog", "cat"];

    // Expected output: array of objects with pattern details
    const results = findPatternsInText(text, patterns);
    console.log("Test 1 Results:", results);

    // Edge case: empty text
    const emptyTextResults = findPatternsInText("", patterns);
    console.log("Test 2 Results (Empty Text):", emptyTextResults);

    // Edge case: empty patterns array
    const emptyPatternsResults = findPatternsInText(text, []);
    console.log("Test 3 Results (Empty Patterns):", emptyPatternsResults);

    // Edge case: pattern not found
    const notFoundResults = findPatternsInText(text, ["unicorn"]);
    console.log("Test 4 Results (Pattern Not Found):", notFoundResults);

    // Error handling: invalid text input
    try {
        findPatternsInText(123, patterns);
    } catch (error) {
        console.log("Test 5 Results (Invalid Text Input):", error.message);
    }

    // Error handling: invalid patterns input
    try {
        findPatternsInText(text, "fox");
    } catch (error) {
        console.log("Test 6 Results (Invalid Patterns Input):", error.message);
    }

    console.log("Tests completed.");
}

// Execute tests
runTests();