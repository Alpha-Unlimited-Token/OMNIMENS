function extractHeadlines(data) {
    // Extract headlines from the given data structure
    const headlines = [];
    const regex = /\bHeadline:\s*(.+?)\s*(?=\[|$)/;

    for (let key in data) {
        const match = regex.exec(data[key]);
        if (match && match[1]) {
            headlines.push(match[1].trim());
        }
    }

    return headlines;
}

