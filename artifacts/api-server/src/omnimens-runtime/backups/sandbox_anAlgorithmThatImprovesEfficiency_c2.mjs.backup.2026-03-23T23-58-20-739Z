function createKnowledgeGraph(concepts) {
    const graph = new Map();

    concepts.forEach(([concept, relatedConcepts]) => {
        if (!graph.has(concept)) graph.set(concept, new Set());
        relatedConcepts.forEach((related) => {
            if (!graph.has(related)) graph.set(related, new Set());
            graph.get(concept).add(related);
            graph.get(related).add(concept);
        });
    });

    return graph;
}

function retrieveRelatedConcepts(graph, concept, depth = 1) {
    if (!graph.has(concept)) return [];
    const visited = new Set();
    const queue = [[concept, 0]];
    const results = [];

    while (queue.length > 0) {
        const [current, currentDepth] = queue.shift();
        if (currentDepth > depth) break;
        if (!visited.has(current)) {
            visited.add(current);
            results.push(current);
            graph.get(current).forEach((neighbor) => {
                if (!visited.has(neighbor)) {
                    queue.push([neighbor, currentDepth + 1]);
                }
            });
        }
    }

    return results.filter((item) => item !== concept);
}

// Self-tests
const concepts = [
    ["AI", ["Machine Learning", "Neural Networks"]],
    ["Machine Learning", ["Deep Learning", "Supervised Learning"]],
    ["Neural Networks", ["Deep Learning", "Backpropagation"]],
    ["Deep Learning", ["Reinforcement Learning"]],
    ["Supervised Learning", ["Classification", "Regression"]],
    ["Reinforcement Learning", ["Q-Learning", "Policy Gradient"]]
];

const knowledgeGraph = createKnowledgeGraph(concepts);

console.log("Knowledge Graph:", knowledgeGraph);

console.log("Related concepts to 'AI' (depth 1):", retrieveRelatedConcepts(knowledgeGraph, "AI", 1));
console.log("Related concepts to 'AI' (depth 2):", retrieveRelatedConcepts(knowledgeGraph, "AI", 2));
console.log("Related concepts to 'Machine Learning' (depth 1):", retrieveRelatedConcepts(knowledgeGraph, "Machine Learning", 1));
console.log("Related concepts to 'Deep Learning' (depth 3):", retrieveRelatedConcepts(knowledgeGraph, "Deep Learning", 3));
console.log("Related concepts to 'Unknown Concept':", retrieveRelatedConcepts(knowledgeGraph, "Unknown Concept", 1));