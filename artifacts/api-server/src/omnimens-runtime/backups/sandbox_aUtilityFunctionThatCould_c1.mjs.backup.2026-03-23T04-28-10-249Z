    } catch (e) {
        console.log(e.message); // Expected: Error message
    }

    console.log('Test 5: Edge case - pattern length longer than text');
    try {
        const result5 = findMostFrequentPatterns('short', 10);
        console.log(result5); // Expected: Error
    } catch (e) {
        console.log(e.message); // Expected: Error message
    }

    console.log('Test 6: Edge case - invalid inputs');
    try {
        const result6 = findMostFrequentPatterns(12345, 'abc');
        console.log(result6); // Expected: Error
    } catch (e) {
        console.log(e.message); // Expected: Error message
    }
}

runTests();