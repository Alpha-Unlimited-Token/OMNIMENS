function findLongestCommonSubstring(str1, str2) {
    if (!str1 || !str2) return "";

    let maxLength = 0;
    let endingIndex = 0;
    const dp = Array(str1.length + 1)
        .fill(0)
        .map(() => Array(str2.length + 1).fill(0));

    for (let i = 1; i <= str1.length; i++) {
        for (let j = 1; j <= str2.length; j++) {
            if (str1[i - 1] === str2[j - 1]) {
                dp[i][j] = dp[i - 1][j - 1] + 1;
                if (dp[i][j] > maxLength) {
                    maxLength = dp[i][j];
                    endingIndex = i - 1;
                }
            }
        }
    }

    return str1.slice(endingIndex - maxLength + 1, endingIndex + 1);
}

// Test cases
console.log(findLongestCommonSubstring("abcdef", "zcdemf")); // Output: "cde"
console.log(findLongestCommonSubstring("12345", "54321"));   // Output: "1"
console.log(findLongestCommonSubstring("hello", "world"));   // Output: ""
console.log(findLongestCommonSubstring("", "nonempty"));     // Output: ""
console.log(findLongestCommonSubstring("nonempty", ""));     // Output: ""
console.log(findLongestCommonSubstring("same", "same"));     // Output: "same"
console.log(findLongestCommonSubstring("abcdxyz", "xyzabcd")); // Output: "abcd"