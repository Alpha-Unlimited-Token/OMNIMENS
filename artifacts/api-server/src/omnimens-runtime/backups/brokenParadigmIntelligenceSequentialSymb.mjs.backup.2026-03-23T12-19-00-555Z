// ResonantField.ts  — pure computation demo
export type Vector = number[];

/** Create a random phase vector (0..2π) */
function randomPhases(n: number): Vector {
  return Array.from({ length: n }, () => Math.random() * 2 * Math.PI);
}

/** One Kuramoto-style update step */
function step(phases: Vector, coupling: number, adjacency: number[][]): Vector {
  const n = phases.length;
  const next = new Array(n);
  for (let i = 0; i < n; i++) {
    let sum = 0;
    for (let j = 0; j < n; j++) sum += adjacency[i][j] * Math.sin(phases[j] - phases[i]);
    next[i] = (phases[i] + coupling * sum) % (2 * Math.PI);
  }
  return next;
}

/** Run until convergence (or maxIter) and return phase pattern */
export function resonate(
  adjacency: number[][],            // concept coupling matrix
  seed: Vector | null = null,
  coupling = 0.05,
  maxIter = 200,
  epsilon = 1e-3
): Vector {
  let phases = seed ?? randomPhases(adjacency.length);
  for (let t = 0; t < maxIter; t++) {
    const next = step(phases, coupling, adjacency);
    const delta = next.reduce((s, θ, k) => s + Math.abs(θ - phases[k]), 0) / phases.length;
    phases = next;
    if (delta < epsilon) break;             // settled attractor
  }
  return phases;
}