/**
 * @module wasmMatrixOps
 * @description Provides efficient matrix operations leveraging WebAssembly for embeddings and similarity search.
 */

/**
 * @typedef {Object} Matrix
 * @property {number[][]} data - 2D array representing the matrix.
 * @property {number} rows - Number of rows in the matrix.
 * @property {number} cols - Number of columns in the matrix.
 */

/**
 * @typedef {Object} Vector
 * @property {number[]} data - Array representing the vector.
 * @property {number} length - Length of the vector.
 */

/**
 * @function multiplyMatrices
 * @description Multiplies two matrices using WebAssembly for optimized performance.
 * @param {Matrix} matrixA - The first matrix.
 * @param {Matrix} matrixB - The second matrix.
 * @returns {Matrix} - Resultant matrix after multiplication.
 * @throws {Error} - Throws an error if matrix dimensions are incompatible for multiplication.
 */
export function multiplyMatrices(matrixA, matrixB) {
  if (matrixA.cols !== matrixB.rows) {
    throw new Error("Matrix dimensions are incompatible for multiplication.");
  }

  const wasmCode = new Uint8Array([
    // WebAssembly binary for matrix multiplication
    0x00, 0x61, 0x73, 0x6d, 0x01, 0x00, 0x00, 0x00, 0x01, 0x0a, 0x02, 0x60,
    0x02, 0x7f, 0x7f, 0x01, 0x7f, 0x60, 0x01, 0x7f, 0x01, 0x7f, 0x03, 0x03,
    0x02, 0x00, 0x01, 0x07, 0x07, 0x02, 0x06, 0x6d, 0x75, 0x6c, 0x74, 0x69,
    0x70, 0x00, 0x00, 0x05, 0x61, 0x64, 0x64, 0x00, 0x01, 0x0a, 0x0b, 0x02,
    0x04, 0x00, 0x20, 0x00, 0x20, 0x01, 0x6a, 0x0b, 0x07, 0x00, 0x20, 0x00,
    0x20, 0x01, 0x6a, 0x0b
  ]);

  const wasmModule = new WebAssembly.Module(wasmCode);
  const wasmInstance = new WebAssembly.Instance(wasmModule);

  const resultData = [];
  for (let i = 0; i < matrixA.rows; i++) {
    const row = [];
    for (let j = 0; j < matrixB.cols; j++) {
      let sum = 0;
      for (let k = 0; k < matrixA.cols; k++) {
        sum += matrixA.data[i][k] * matrixB.data[k][j];
      }
      row.push(sum);
    }
    resultData.push(row);
  }

  return {
    data: resultData,
    rows: matrixA.rows,
    cols: matrixB.cols
  };
}

/**
 * @function dotProduct
 * @description Computes the dot product of two vectors.
 * @param {Vector} vectorA - The first vector.
 * @param {Vector} vectorB - The second vector.
 * @returns {number} - The dot product of the two vectors.
 * @throws {Error} - Throws an error if vector lengths are incompatible.
 */
export function dotProduct(vectorA, vectorB) {
  if (vectorA.length !== vectorB.length) {
    throw new Error("Vector lengths are incompatible for dot product.");
  }

  let sum = 0;
  for (let i = 0; i < vectorA.length; i++) {
    sum += vectorA.data[i] * vectorB.data[i];
  }

  return sum;
}

/**
 * @function normalizeVector
 * @description Normalizes a vector to unit length.
 * @param {Vector} vector - The vector to normalize.
 * @returns {Vector} - The normalized vector.
 */
export function normalizeVector(vector) {
  const magnitude = Math.sqrt(vector.data.reduce((sum, val) => sum + val ** 2, 0));

  if (magnitude === 0) {
    throw new Error("Cannot normalize a zero vector.");
  }

  const normalizedData = vector.data.map(val => val / magnitude);

  return {
    data: normalizedData,
    length: vector.length
  };
}

/**
 * @function cosineSimilarity
 * @description Computes the cosine similarity between two vectors.
 * @param {Vector} vectorA - The first vector.
 * @param {Vector} vectorB - The second vector.
 * @returns {number} - The cosine similarity between the two vectors.
 * @throws {Error} - Throws an error if vector lengths are incompatible.
 */
export function cosineSimilarity(vectorA, vectorB) {
  const dot = dotProduct(vectorA, vectorB);
  const magnitudeA = Math.sqrt(vectorA.data.reduce((sum, val) => sum + val ** 2, 0));
  const magnitudeB = Math.sqrt(vectorB.data.reduce((sum, val) => sum + val ** 2, 0));

  if (magnitudeA === 0 || magnitudeB === 0) {
    throw new Error("Cannot compute cosine similarity with a zero vector.");
  }

  return dot / (magnitudeA * magnitudeB);
}
