function extractTableFromText(text) {
    // Extracts tabular data from text where rows are separated by newlines
    // and columns are separated by a delimiter (default is '|').
    const delimiter = '|';
    const rows = text.split('\n').map(row => row.trim()).filter(row => row.length > 0);
    const table = rows.map(row => row.split(delimiter).map(cell => cell.trim()));
    return table;
}

function analyzeTableData(table) {
    // Analyzes the table data to calculate:
    // 1. Number of rows and columns
    // 2. Maximum and minimum values in numeric columns
    // 3. Column-wise data type inference (numeric or text)
    const numRows = table.length;
    const numCols = table[0] ? table[0].length : 0;

    const columnAnalysis = [];
    for (let col = 0; col < numCols; col++) {
        const columnData = table.map(row => row[col]);
        const numericValues = columnData.map(value => parseFloat(value)).filter(value => !isNaN(value));
        const isNumeric = numericValues.length === columnData.length;

        columnAnalysis.push({
            isNumeric: isNumeric,
            max: isNumeric ? Math.max(...numericValues) : null,
            min: isNumeric ? Math.min(...numericValues) : null,
            dataType: isNumeric ? 'Numeric' : 'Text'
        });
    }

    return {
        numRows: numRows,
        numCols: numCols,
        columnAnalysis: columnAnalysis
    };
}

