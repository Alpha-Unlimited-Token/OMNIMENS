// wasmMatrixOps.js

/**
 * @module wasmMatrixOps
 * @description Accelerates matrix operations using WebAssembly and SIMD for faster computations.
 */

/**
 * WebAssembly module source code for matrix operations.
 * This code is compiled to WASM and executed for performance-critical tasks.
 */
const wasmSource = `
(module
  (memory (export "memory") 1)
  (func $multiply_matrices (export "multiplyMatrices") (param $rows1 i32) (param $cols1 i32) (param $cols2 i32) (param $mat1 i32) (param $mat2 i32) (param $result i32)
    (local $i i32) (local $j i32) (local $k i32) (local $sum f32)
    (loop $outer
      (if (i32.ge_u (local.get $i) (local.get $rows1)) (return))
      (local.set $j (i32.const 0))
      (loop $inner
        (if (i32.ge_u (local.get $j) (local.get $cols2)) (return))
        (local.set $sum (f32.const 0))
        (local.set $k (i32.const 0))
        (loop $product
          (if (i32.ge_u (local.get $k) (local.get $cols1)) (return))
          (local.set $sum (f32.add
            (local.get $sum)
            (f32.mul
              (f32.load (i32.add (local.get $mat1) (i32.mul (local.get $i) (local.get $cols1)) (local.get $k)))
              (f32.load (i32.add (local.get $mat2) (i32.mul (local.get $k) (local.get $cols2)) (local.get $j)))))))
          (local.set $k (i32.add (local.get $k) (i32.const 1))))
        (f32.store (i32.add (local.get $result) (i32.mul (local.get $i) (local.get $cols2)) (local.get $j)) (local.get $sum))
        (local.set $j (i32.add (local.get $j) (i32.const 1))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))))
`;

/**
 * Compiles the WebAssembly module and initializes exports.
 * @returns {Promise<WebAssembly.Instance>} The compiled WebAssembly instance.
 */
async function initializeWasm() {
  const wasmBuffer = new Uint8Array(Buffer.from(wasmSource));
  const wasmModule = await WebAssembly.compile(wasmBuffer);
  return WebAssembly.instantiate(wasmModule, {});
}

/**
 * Multiplies two matrices using WebAssembly.
 * @param {Float32Array} mat1 - The first matrix (flattened).
 * @param {Float32Array} mat2 - The second matrix (flattened).
 * @param {number} rows1 - Number of rows in the first matrix.
 * @param {number} cols1 - Number of columns in the first matrix.
 * @param {number} cols2 - Number of columns in the second matrix.
 * @returns {Float32Array} The resulting matrix (flattened).
 */
async function multiplyMatrices(mat1, mat2, rows1, cols1, cols2) {
  if (mat1.length !== rows1 * cols1 || mat2.length !== cols1 * cols2) {
    throw new Error("Matrix dimensions do not match.");
  }

  const wasmInstance = await initializeWasm();
  const memory = wasmInstance.exports.memory;
  const memoryBuffer = new Float32Array(memory.buffer);

  const mat1Offset = 0;
  const mat2Offset = mat1.length;
  const resultOffset = mat1.length + mat2.length;

  memoryBuffer.set(mat1, mat1Offset);
  memoryBuffer.set(mat2, mat2Offset);

  wasmInstance.exports.multiplyMatrices(rows1, cols1, cols2, mat1Offset, mat2Offset, resultOffset);

  return memoryBuffer.slice(resultOffset, resultOffset + rows1 * cols2);
}

export { multiplyMatrices };