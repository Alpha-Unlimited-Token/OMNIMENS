/**
 * Compiles a WebAssembly module from the provided textual representation of WebAssembly code.
 * @param {string} wasmCode - The textual WebAssembly (WAT) code.
 * @returns {Promise<WebAssembly.Instance>} A promise that resolves to the WebAssembly instance.
 */
async function compileWasm(wasmCode) {
  const encoder = new TextEncoder();
  const wasmBuffer = encoder.encode(wasmCode);
  const wasmModule = await WebAssembly.compile(wasmBuffer);
  return WebAssembly.instantiate(wasmModule);
}

