function KnowledgeRetrievalSystem() {
    this.concepts = new Map();
    this.associations = new Map();

    // Add a concept to the system
    this.addConcept = function (concept, data) {
        if (!this.concepts.has(concept)) {
            this.concepts.set(concept, data);
            this.associations.set(concept, new Set());
        }
    };

    // Associate two concepts bidirectionally
    this.associateConcepts = function (concept1, concept2) {
        if (this.concepts.has(concept1) && this.concepts.has(concept2)) {
            this.associations.get(concept1).add(concept2);
            this.associations.get(concept2).add(concept1);
        }
    };

    // Retrieve data for a concept
    this.retrieveConceptData = function (concept) {
        return this.concepts.get(concept) || null;
    };

    // Find related concepts based on associations
    this.findRelatedConcepts = function (concept) {
        return this.associations.has(concept) ? Array.from(this.associations.get(concept)) : [];
    };

    // Pattern recognition: Find clusters of related concepts
    this.findClusters = function () {
        const visited = new Set();
        const clusters = [];

        const dfs = (concept, cluster) => {
            if (visited.has(concept)) return;
            visited.add(concept);
            cluster.push(concept);
            for (const related of this.associations.get(concept) || []) {
                dfs(related, cluster);
            }
        };

        for (const concept of this.concepts.keys()) {
            if (!visited.has(concept)) {
                const cluster = [];
                dfs(concept, cluster);
                clusters.push(cluster);
            }
        }

        return clusters;
    };

    // Test cases
    this.runTests = function () {
        console.log("Running tests...");

        // Add concepts
        this.addConcept("A", { info: "Concept A data" });
        this.addConcept("B", { info: "Concept B data" });
        this.addConcept("C", { info: "Concept C data" });
        this.addConcept("D", { info: "Concept D data" });
        this.addConcept("E", { info: "Concept E data" });

        // Associate concepts
        this.associateConcepts("A", "B");
        this.associateConcepts("B", "C");
        this.associateConcepts("D", "E");

        // Test retrieval
        console.log("Retrieve A:", this.retrieveConceptData("A")); // Should output Concept A data
        console.log("Retrieve B:", this.retrieveConceptData("B")); // Should output Concept B data
        console.log("Retrieve Z:", this.retrieveConceptData("Z")); // Should output null

        // Test related concepts
        console.log("Related to B:", this.findRelatedConcepts("B")); // Should output ["A", "C"]
        console.log("Related to D:", this.findRelatedConcepts("D")); // Should output ["E"]
        console.log("Related to Z:", this.findRelatedConcepts("Z")); // Should output []

        // Test clusters
        console.log("Clusters:", JSON.stringify(this.findClusters())); // Should output [["A", "B", "C"], ["D", "E"]]

        console.log("Tests completed.");
    };
}

// Instantiate and run tests
const system = new KnowledgeRetrievalSystem();
system.runTests();