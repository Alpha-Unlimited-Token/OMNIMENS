// contextCompression.mjs

import crypto from 'crypto';

/**
 * Generates a compact semantic representation of a text input using a dynamic summarization algorithm.
 * @param {string} text - The text to summarize.
 * @param {number} maxTokens - The maximum token length for the compressed representation.
 * @returns {string} - A compressed semantic representation of the input text.
 */
export function compressContext(text, maxTokens) {
  if (typeof text !== 'string' || typeof maxTokens !== 'number' || maxTokens <= 0) {
    throw new Error('Invalid input: text must be a string and maxTokens must be a positive number.');
  }

  const words = text.split(/\s+/);
  if (words.length <= maxTokens) {
    return text; // No compression needed
  }

  const chunkSize = Math.ceil(words.length / maxTokens);
  const compressedChunks = [];

  for (let i = 0; i < words.length; i += chunkSize) {
    const chunk = words.slice(i, i + chunkSize).join(' ');
    const hash = crypto.createHash('sha256').update(chunk).digest('hex').slice(0, 8);
    compressedChunks.push(`${chunk.split(' ').slice(0, 2).join(' ')}...(${hash})`);
  }

  return compressedChunks.join(' ');
}

/**
 * Reconstructs a semantic representation from compressed context.
 * Note: This is a placeholder function as full reconstruction is not feasible without additional data.
 * @param {string} compressedText - The compressed semantic representation.
 * @returns {string} - The reconstructed approximation of the original text.
 */
export function reconstructContext(compressedText) {
  if (typeof compressedText !== 'string') {
    throw new Error('Invalid input: compressedText must be a string.');
  }

  return compressedText.replace(/\.{3}\(.*?\)/g, '...');
}

/**
 * Dynamically adjusts the compression level based on token window constraints.
 * @param {string} text - The text to compress.
 * @param {number} tokenWindow - The maximum allowable token window.
 * @returns {string} - The dynamically compressed text.
 */
export function dynamicCompression(text, tokenWindow) {
  if (typeof text !== 'string' || typeof tokenWindow !== 'number' || tokenWindow <= 0) {
    throw new Error('Invalid input: text must be a string and tokenWindow must be a positive number.');
  }

  let compressed = text;
  while (compressed.split(/\s+/).length > tokenWindow) {
    compressed = compressContext(compressed, tokenWindow);
  }

  return compressed;
}

/**
 * Calculates a semantic similarity score between two pieces of text using a simple hash comparison.
 * @param {string} text1 - The first text input.
 * @param {string} text2 - The second text input.
 * @returns {number} - A similarity score between 0 and 1 (1 = identical, 0 = completely different).
 */
export function calculateSemanticSimilarity(text1, text2) {
  if (typeof text1 !== 'string' || typeof text2 !== 'string') {
    throw new Error('Invalid input: both inputs must be strings.');
  }

  const hash1 = crypto.createHash('sha256').update(text1).digest('hex');
  const hash2 = crypto.createHash('sha256').update(text2).digest('hex');

  let matches = 0;
  for (let i = 0; i < hash1.length; i++) {
    if (hash1[i] === hash2[i]) matches++;
  }

  return matches / hash1.length;
}

/**
 * Splits a large text into manageable chunks while preserving semantic coherence.
 * @param {string} text - The text to split.
 * @param {number} chunkSize - The maximum size of each chunk in tokens.
 * @returns {string[]} - An array of text chunks.
 */
export function splitIntoChunks(text, chunkSize) {
  if (typeof text !== 'string' || typeof chunkSize !== 'number' || chunkSize <= 0) {
    throw new Error('Invalid input: text must be a string and chunkSize must be a positive number.');
  }

  const words = text.split(/\s+/);
  const chunks = [];

  for (let i = 0; i < words.length; i += chunkSize) {
    chunks.push(words.slice(i, i + chunkSize).join(' '));
  }

  return chunks;
}
