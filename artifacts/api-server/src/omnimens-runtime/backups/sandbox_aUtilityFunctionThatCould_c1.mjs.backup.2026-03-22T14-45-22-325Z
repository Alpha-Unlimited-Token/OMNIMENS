// Utility function: Extracts named entities from text using simple pattern matching
// This function identifies potential named entities based on capitalization patterns.

function extractNamedEntities(text) {
    if (typeof text !== 'string') {
        throw new Error("Input must be a string");
    }

    // Regular expression to match potential named entities (words starting with capital letters)
    const namedEntityPattern = /\b[A-Z][a-z]*\b(?:\s+[A-Z][a-z]*)*/g;
    const matches = text.match(namedEntityPattern);

    // Remove duplicates and return
    return matches ? Array.from(new Set(matches)) : [];
}

// Test cases
function testExtractNamedEntities() {
    console.log("Test 1: Simple sentence");
    console.log(extractNamedEntities("Alice went to Wonderland to meet the Cheshire Cat."));
    // Expected output: ['Alice', 'Wonderland', 'Cheshire', 'Cat']

    console.log("Test 2: Sentence with no named entities");
    console.log(extractNamedEntities("the quick brown fox jumps over the lazy dog."));
    // Expected output: []

    console.log("Test 3: Mixed case with duplicates");
    console.log(extractNamedEntities("John met John in New York City."));
    // Expected output: ['John', 'New York City']

    console.log("Test 4: Empty string");
    console.log(extractNamedEntities(""));
    // Expected output: []

    console.log("Test 5: Non-string input");
    try {
        console.log(extractNamedEntities(12345));
    } catch (e) {
        console.log(e.message);
        // Expected output: "Input must be a string"
    }

    console.log("Test 6: Complex sentence");
    console.log(extractNamedEntities("Dr. Strange and Spider-Man visited Stark Industries in New York."));
    // Expected output: ['Dr', 'Strange', 'Spider-Man', 'Stark Industries', 'New York']
}

// Run tests
testExtractNamedEntities();