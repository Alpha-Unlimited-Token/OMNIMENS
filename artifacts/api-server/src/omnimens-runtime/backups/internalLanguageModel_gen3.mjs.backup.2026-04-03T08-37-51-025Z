import crypto from 'crypto';

/**
 * Generate a random seed for deterministic operations.
 * @returns {number} A random seed value.
 */
export function generateSeed() {
  const buffer = crypto.randomBytes(4);
  return buffer.readUInt32BE(0);
}

/**
 * Initialize weights for a lightweight transformer model.
 * @param {number} size - The size of the weight matrix.
 * @returns {Float32Array} Initialized weights.
 */
export function initializeWeights(size) {
  const weights = new Float32Array(size);
  const seed = generateSeed();
  const random = crypto.createHash('sha256').update(seed.toString()).digest();
  for (let i = 0; i < size; i++) {
    weights[i] = (random[i % random.length] / 255) * 2 - 1; // Normalize to [-1, 1]
  }
  return weights;
}

/**
 * Compute scaled dot-product attention.
 * @param {Float32Array} query - Query vector.
 * @param {Float32Array} key - Key vector.
 * @param {Float32Array} value - Value vector.
 * @returns {Float32Array} Attention-weighted output.
 */
export function computeAttention(query, key, value) {
  if (query.length !== key.length || key.length !== value.length) {
    throw new Error('Query, Key, and Value vectors must have the same length.');
  }

  const dotProduct = query.reduce((sum, q, i) => sum + q * key[i], 0);
  const scale = Math.sqrt(query.length);
  const attentionScore = Math.exp(dotProduct / scale);

  const weightedValue = new Float32Array(value.length);
  for (let i = 0; i < value.length; i++) {
    weightedValue[i] = attentionScore * value[i];
  }

  return weightedValue;
}

/**
 * Normalize a vector using softmax.
 * @param {Float32Array} vector - Input vector.
 * @returns {Float32Array} Softmax-normalized vector.
 */
export function softmax(vector) {
  const max = Math.max(...vector);
  const expVector = vector.map(v => Math.exp(v - max));
  const sumExp = expVector.reduce((sum, v) => sum + v, 0);
  return new Float32Array(expVector.map(v => v / sumExp));
}

/**
 * Generate a conversational response based on input embeddings.
 * @param {Float32Array} inputEmbedding - Input embedding vector.
 * @param {Float32Array} weights - Transformer model weights.
 * @returns {Float32Array} Generated response embedding.
 */
export function generateResponse(inputEmbedding, weights) {
  if (inputEmbedding.length !== weights.length) {
    throw new Error('Input embedding and weights must have the same length.');
  }

  const attentionOutput = computeAttention(inputEmbedding, weights, weights);
  return softmax(attentionOutput);
}

/**
 * Utility function for embedding similarity.
 * @param {Float32Array} embeddingA - First embedding vector.
 * @param {Float32Array} embeddingB - Second embedding vector.
 * @returns {number} Cosine similarity score.
 */
export function cosineSimilarity(embeddingA, embeddingB) {
  if (embeddingA.length !== embeddingB.length) {
    throw new Error('Embedding vectors must have the same length.');
  }

  const dotProduct = embeddingA.reduce((sum, a, i) => sum + a * embeddingB[i], 0);
  const magnitudeA = Math.sqrt(embeddingA.reduce((sum, a) => sum + a * a, 0));
  const magnitudeB = Math.sqrt(embeddingB.reduce((sum, b) => sum + b * b, 0));

  return dotProduct / (magnitudeA * magnitudeB);
}

/**
 * Generate random embeddings for testing purposes.
 * @param {number} size - Size of the embedding vector.
 * @returns {Float32Array} Random embedding vector.
 */
export function generateRandomEmbedding(size) {
  return initializeWeights(size);
}