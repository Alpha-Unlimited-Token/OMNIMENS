function findPatternsInText(text, patterns) {
    // Utility function to find patterns in a given text
    // text: string - the text to search within
    // patterns: array of strings - the patterns to search for
    // Returns an object with pattern counts and matched indices

    if (typeof text !== 'string' || !Array.isArray(patterns)) {
        throw new Error("Invalid input: 'text' must be a string and 'patterns' must be an array of strings.");
    }

    const results = {};
    patterns.forEach(pattern => {
        if (typeof pattern !== 'string') {
            throw new Error("Invalid pattern: All patterns must be strings.");
        }

        const regex = new RegExp(pattern, 'g'); // Global search for the pattern
        const matches = [...text.matchAll(regex)];
        results[pattern] = {
            count: matches.length,
            indices: matches.map(match => match.index)
        };
    });

    return results;
}

