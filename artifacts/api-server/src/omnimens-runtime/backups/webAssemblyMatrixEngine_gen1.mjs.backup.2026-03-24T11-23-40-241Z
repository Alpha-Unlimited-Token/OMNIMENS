// webAssemblyMatrixEngine.mjs

import { createHash } from 'crypto';

// Utility to compile WebAssembly source code
export async function compileWebAssembly(source) {
  const encoder = new TextEncoder();
  const wasmBytes = encoder.encode(source);
  const module = await WebAssembly.compile(wasmBytes);
  return module;
}

// Generic matrix multiplication function for WebAssembly
export function generateMatrixMultiplicationWasmSource() {
  return `
    (module
      (func $multiply (param $rows i32) (param $cols i32) (param $common i32) (param $a i32) (param $b i32) (param $result i32)
        (local $i i32) (local $j i32) (local $k i32) (local $sum f64)
        (loop $outerLoop
          (set_local $i (i32.add (get_local $i) (i32.const 1)))
          (br_if $outerLoop (i32.lt_s (get_local $i) (get_local $rows)))
          (loop $innerLoop
            (set_local $j (i32.add (get_local $j) (i32.const 1)))
            (br_if $innerLoop (i32.lt_s (get_local $j) (get_local $cols)))
            (set_local $sum (f64.const 0))
            (loop $sumLoop
              (set_local $k (i32.add (get_local $k) (i32.const 1)))
              (br_if $sumLoop (i32.lt_s (get_local $k) (get_local $common)))
              (set_local $sum (f64.add (get_local $sum) (f64.mul
                (f64.load (i32.add (get_local $a) (i32.mul (get_local $i) (get_local $common))))
                (f64.load (i32.add (get_local $b) (i32.mul (get_local $k) (get_local $cols))))
              ))))
            (f64.store (i32.add (get_local $result) (i32.mul (get_local $i) (get_local $cols))) (get_local $sum))
          )
        )
      )
      (export "multiply" (func $multiply))
    )
  `;
}

// Example: Initialize WebAssembly for matrix multiplication
export async function initializeMatrixMultiplicationEngine() {
  const wasmSource = generateMatrixMultiplicationWasmSource();
  const module = await compileWebAssembly(wasmSource);
  const instance = await WebAssembly.instantiate(module);
  return instance;
}

// Helper for hashing matrices (useful for caching or verification)
export function hashMatrix(matrix) {
  const hash = createHash('sha256');
  matrix.flat().forEach(value => hash.update(value.toString()));
  return hash.digest('hex');
}

// Utility to validate matrix dimensions for operations
export function validateMatrixDimensions(a, b) {
  if (!Array.isArray(a) || !Array.isArray(b)) {
    throw new Error('Both inputs must be arrays.');
  }
  const aRows = a.length;
  const aCols = a[0].length;
  const bRows = b.length;
  const bCols = b[0].length;
  if (aCols !== bRows) {
    throw new Error('Matrix dimensions are incompatible for multiplication.');
  }
  return { aRows, aCols, bRows, bCols };
}

// Main matrix multiplication function using JavaScript
export function matrixMultiply(a, b) {
  const { aRows, aCols, bRows, bCols } = validateMatrixDimensions(a, b);
  const result = Array.from({ length: aRows }, () => Array(bCols).fill(0));
  for (let i = 0; i < aRows; i++) {
    for (let j = 0; j < bCols; j++) {
      for (let k = 0; k < aCols; k++) {
        result[i][j] += a[i][k] * b[k][j];
      }
    }
  }
  return result;
}
