function runTests() {
    console.log("Running tests...");

    // Test 1: Basic similarity
    let vec1 = [1, 2, 3];
    let vec2 = [1, 2, 3];
    console.log("Test 1:", cosineSimilarity(vec1, vec2) === 1 ? "Passed" : "Failed");

    // Test 2: Orthogonal vectors
    vec1 = [1, 0];
    vec2 = [0, 1];
    console.log("Test 2:", cosineSimilarity(vec1, vec2) === 0 ? "Passed" : "Failed");

    // Test 3: Different magnitudes
    vec1 = [1, 2, 3];
    vec2 = [2, 4, 6];
    console.log("Test 3:", cosineSimilarity(vec1, vec2) === 1 ? "Passed" : "Failed");

    // Test 4: Zero vector
    vec1 = [0, 0, 0];
    vec2 = [1, 2, 3];
    console.log("Test 4:", cosineSimilarity(vec1, vec2) === 0 ? "Passed" : "Failed");

    // Test 5: Negative values
    vec1 = [-1, -2, -3];
    vec2 = [1, 2, 3];
    console.log("Test 5:", cosineSimilarity(vec1, vec2) === -1 ? "Passed" : "Failed");

    // Test 6: Edge case - unequal lengths
    try {
        vec1 = [1, 2];
        vec2 = [1, 2, 3];
        cosineSimilarity(vec1, vec2);
        console.log("Test 6: Failed");
    } catch (e) {
        console.log("Test 6: Passed");
    }

    console.log("Tests completed.");
}

runTests();