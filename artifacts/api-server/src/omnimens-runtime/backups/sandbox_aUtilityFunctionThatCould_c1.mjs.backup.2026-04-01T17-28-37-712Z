// Utility function: Text Pattern Frequency Analyzer
// This function analyzes a given text and returns the frequency of specified patterns or words.

function analyzePatternFrequency(text, patterns) {
    if (typeof text !== 'string' || !Array.isArray(patterns)) {
        throw new TypeError('Invalid input: text must be a string and patterns must be an array.');
    }
    
    const frequencies = {};
    patterns.forEach(pattern => {
        if (typeof pattern !== 'string') {
            throw new TypeError('Invalid pattern: each pattern must be a string.');
        }
        const regex = new RegExp(pattern, 'gi');
        const matches = text.match(regex);
        frequencies[pattern] = matches ? matches.length : 0;
    });
    return frequencies;
}

