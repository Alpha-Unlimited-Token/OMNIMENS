import { performance } from 'perf_hooks';

/**
 * Utility functions for GPU-accelerated matrix operations.
 * This module uses WebGPU-compatible algorithms to perform matrix multiplication,
 * LU decomposition, and eigenvalue computation efficiently.
 */

/**
 * Multiplies two matrices (A and B) using a CPU-based fallback algorithm.
 * This is a placeholder for GPU acceleration in environments where WebGPU is not available.
 * @param {number[][]} A - The first matrix (m x n).
 * @param {number[][]} B - The second matrix (n x p).
 * @returns {number[][]} - The resulting matrix (m x p).
 */
export function matrixMultiply(A, B) {
  const m = A.length;
  const n = A[0].length;
  const p = B[0].length;

  if (B.length !== n) {
    throw new Error('Matrix dimensions do not match for multiplication.');
  }

  const result = Array.from({ length: m }, () => Array(p).fill(0));

  for (let i = 0; i < m; i++) {
    for (let j = 0; j < p; j++) {
      for (let k = 0; k < n; k++) {
        result[i][j] += A[i][k] * B[k][j];
      }
    }
  }

  return result;
}

/**
 * Performs LU decomposition on a square matrix A.
 * Decomposes A into L (lower triangular) and U (upper triangular).
 * @param {number[][]} A - The square matrix (n x n).
 * @returns {{ L, U}} - The decomposed matrices L and U.
 */
export function luDecomposition(A) {
  const n = A.length;

  const L = Array.from({ length: n }, (_, i) => Array(n).fill(0));
  const U = Array.from({ length: n }, (_, i) => Array(n).fill(0));

  for (let i = 0; i < n; i++) {
    for (let j = i; j < n; j++) {
      let sum = 0;
      for (let k = 0; k < i; k++) {
        sum += L[i][k] * U[k][j];
      }
      U[i][j] = A[i][j] - sum;
    }

    for (let j = i; j < n; j++) {
      if (i === j) {
        L[i][i] = 1;
      } else {
        let sum = 0;
        for (let k = 0; k < i; k++) {
          sum += L[j][k] * U[k][i];
        }
        L[j][i] = (A[j][i] - sum) / U[i][i];
      }
    }
  }

  return { L, U };
}

/**
 * Computes the eigenvalues of a 2x2 matrix using a closed-form solution.
 * This is a simplified implementation for demonstration purposes.
 * @param {number[][]} A - The 2x2 matrix.
 * @returns {number[]} - The eigenvalues of the matrix.
 */
export function computeEigenvalues(A) {
  if (A.length !== 2 || A[0].length !== 2) {
    throw new Error('Eigenvalue computation is currently supported only for 2x2 matrices.');
  }

  const a = A[0][0];
  const b = A[0][1];
  const c = A[1][0];
  const d = A[1][1];

  const trace = a + d;
  const determinant = a * d - b * c;

  const discriminant = Math.sqrt(trace * trace - 4 * determinant);

  const eigenvalue1 = (trace + discriminant) / 2;
  const eigenvalue2 = (trace - discriminant) / 2;

  return [eigenvalue1, eigenvalue2];
}

/**
 * Measures the execution time of a function.
 * @param {Function} fn - The function to measure.
 * @param {...any} args - Arguments to pass to the function.
 * @returns {{ result, time}} - The result of the function and the execution time in milliseconds.
 */
export function measureExecutionTime(fn, ...args) {
  const start = performance.now();
  const result = fn(...args);
  const end = performance.now();
  return { result, time: end - start };
}

/**
 * Validates if a matrix is square.
 * @param {number[][]} matrix - The matrix to validate.
 * @returns {boolean} - True if the matrix is square, false otherwise.
 */
export function isSquareMatrix(matrix) {
  return matrix.length > 0 && matrix.length === matrix[0].length;
}

/**
 * Validates if two matrices can be multiplied.
 * @param {number[][]} A - The first matrix.
 * @param {number[][]} B - The second matrix.
 * @returns {boolean} - True if the matrices can be multiplied, false otherwise.
 */
export function canMultiplyMatrices(A, B) {
  return A[0].length === B.length;
}
