import { GPU } from 'gpu.js';

// Initialize GPU.js instance
const gpu = new GPU();

/**
 * Multiplies two matrices using WebGPU for parallelized computation.
 * @param {Float32Array} matrixA - The first matrix (flattened row-major order).
 * @param {Float32Array} matrixB - The second matrix (flattened row-major order).
 * @param {number} rowsA - Number of rows in matrixA.
 * @param {number} colsA - Number of columns in matrixA (must match rowsB).
 * @param {number} colsB - Number of columns in matrixB.
 * @returns {Float32Array} - Resultant matrix (flattened row-major order).
 */
export function gpuMatrixMultiply(matrixA, matrixB, rowsA, colsA, colsB) {
  if (matrixA.length !== rowsA * colsA || matrixB.length !== colsA * colsB) {
    throw new Error('Matrix dimensions do not match input sizes.');
  }

  const multiplyKernel = gpu.createKernel(function (a, b, colsA, colsB) {
    let sum = 0;
    for (let k = 0; k < colsA; k++) {
      sum += a[this.thread.y * colsA + k] * b[k * colsB + this.thread.x];
    }
    return sum;
  })
    .setOutput([colsB, rowsA])
    .setPipeline(true);

  const result = multiplyKernel(matrixA, matrixB, colsA, colsB);
  return new Float32Array(result.buffer);
}

/**
 * Performs LU decomposition of a square matrix using WebGPU.
 * @param {Float32Array} matrix - The input matrix (flattened row-major order).
 * @param {number} size - The number of rows/columns in the square matrix.
 * @returns {{ L: Float32Array, U: Float32Array }} - Decomposed L and U matrices.
 */
export function gpuLUDecomposition(matrix, size) {
  if (matrix.length !== size * size) {
    throw new Error('Matrix must be square with dimensions size x size.');
  }

  const L = new Float32Array(size * size).fill(0);
  const U = new Float32Array(size * size).fill(0);

  for (let i = 0; i < size; i++) {
    for (let j = i; j < size; j++) {
      let sum = 0;
      for (let k = 0; k < i; k++) {
        sum += L[i * size + k] * U[k * size + j];
      }
      U[i * size + j] = matrix[i * size + j] - sum;
    }

    for (let j = i; j < size; j++) {
      if (i === j) {
        L[i * size + i] = 1;
      } else {
        let sum = 0;
        for (let k = 0; k < i; k++) {
          sum += L[j * size + k] * U[k * size + i];
        }
        L[j * size + i] = (matrix[j * size + i] - sum) / U[i * size + i];
      }
    }
  }

  return { L, U };
}

/**
 * Utility function to validate matrix dimensions.
 * @param {Float32Array} matrix - The matrix to validate.
 * @param {number} rows - Expected number of rows.
 * @param {number} cols - Expected number of columns.
 * @throws {Error} - If matrix dimensions are invalid.
 */
export function validateMatrixDimensions(matrix, rows, cols) {
  if (matrix.length !== rows * cols) {
    throw new Error(`Matrix dimensions do not match expected ${rows}x${cols}.`);
  }
}

/**
 * Converts a 2D array to a flattened Float32Array.
 * @param {number[][]} array2D - The 2D array to flatten.
 * @returns {Float32Array} - Flattened Float32Array.
 */
export function flatten2DArray(array2D) {
  return new Float32Array(array2D.flat());
}

/**
 * Converts a flattened Float32Array to a 2D array.
 * @param {Float32Array} array - The flattened array.
 * @param {number} rows - Number of rows in the 2D array.
 * @param {number} cols - Number of columns in the 2D array.
 * @returns {number[][]} - 2D array representation.
 */
export function unflattenTo2DArray(array, rows, cols) {
  validateMatrixDimensions(array, rows, cols);
  const result = [];
  for (let i = 0; i < rows; i++) {
    result.push(Array.from(array.slice(i * cols, (i + 1) * cols)));
  }
  return result;
}
