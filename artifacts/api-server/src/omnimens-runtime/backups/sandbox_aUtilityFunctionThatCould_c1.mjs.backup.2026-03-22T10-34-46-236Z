// Utility Function: Token Frequency Counter
// This function analyzes a given text and returns the frequency of each token (word).
// It is useful for text analysis, pattern recognition, and natural language processing tasks.

function tokenFrequencyCounter(text) {
    if (typeof text !== 'string') {
        throw new Error("Input must be a string");
    }

    // Normalize the text: convert to lowercase and remove non-alphanumeric characters (except spaces)
    const normalizedText = text.toLowerCase().replace(/[^a-z0-9\s]/g, '');

    // Split the text into tokens (words)
    const tokens = normalizedText.split(/\s+/).filter(token => token.length > 0);

    // Count the frequency of each token
    const frequencyMap = {};
    for (let token of tokens) {
        frequencyMap[token] = (frequencyMap[token] || 0) + 1;
    }

    return frequencyMap;
}

