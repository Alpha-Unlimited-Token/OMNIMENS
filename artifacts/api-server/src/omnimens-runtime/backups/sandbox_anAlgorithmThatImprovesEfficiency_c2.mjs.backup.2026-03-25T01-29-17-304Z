// Algorithm to improve efficiency of knowledge retrieval and pattern recognition using a Trie structure

function TrieNode() {
  this.children = {};
  this.isEndOfWord = false;
}

function Trie() {
  this.root = new TrieNode();
}

// Insert a word into the Trie
Trie.prototype.insert = function (word) {
  let node = this.root;
  for (let char of word) {
    if (!node.children[char]) {
      node.children[char] = new TrieNode();
    }
    node = node.children[char];
  }
  node.isEndOfWord = true;
};

// Search for a word in the Trie
Trie.prototype.search = function (word) {
  let node = this.root;
  for (let char of word) {
    if (!node.children[char]) {
      return false;
    }
    node = node.children[char];
  }
  return node.isEndOfWord;
};

// Retrieve all words in the Trie that start with a given prefix
Trie.prototype.startsWith = function (prefix) {
  let node = this.root;
  for (let char of prefix) {
    if (!node.children[char]) {
      return [];
    }
    node = node.children[char];
  }
  return this._collectWords(node, prefix);
};

// Helper function to collect all words from a given node
Trie.prototype._collectWords = function (node, prefix) {
  let words = [];
  if (node.isEndOfWord) {
    words.push(prefix);
  }
  for (let char in node.children) {
    words = words.concat(this._collectWords(node.children[char], prefix + char));
  }
  return words;
};

// Self-tests
function runTests() {
  const trie = new Trie();

  // Insert words
  trie.insert("knowledge");
  trie.insert("know");
  trie.insert("knack");
  trie.insert("pattern");
  trie.insert("recognition");
  trie.insert("recursive");
  trie.insert("rubric");

  // Test search functionality
  console.log("Search 'knowledge':", trie.search("knowledge")); // Expected: true
  console.log("Search 'know':", trie.search("know")); // Expected: true
  console.log("Search 'unknown':", trie.search("unknown")); // Expected: false

  // Test prefix-based retrieval
  console.log("Words starting with 'kn':", trie.startsWith("kn")); // Expected: ['knowledge', 'know', 'knack']
  console.log("Words starting with 'rec':", trie.startsWith("rec")); // Expected: ['recursive', 'recognition']
  console.log("Words starting with 'rub':", trie.startsWith("rub")); // Expected: ['rubric']
  console.log("Words starting with 'xyz':", trie.startsWith("xyz")); // Expected: []
}

runTests();