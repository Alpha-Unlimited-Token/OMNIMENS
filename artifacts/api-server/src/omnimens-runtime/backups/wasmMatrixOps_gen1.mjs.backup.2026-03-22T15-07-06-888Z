/**
 * Performs matrix multiplication using WebAssembly.
 * @param {Float32Array} matrixA - The first matrix (flattened row-major).
 * @param {Float32Array} matrixB - The second matrix (flattened row-major).
 * @param {number} rowsA - Number of rows in matrixA.
 * @param {number} colsA - Number of columns in matrixA.
 * @param {number} colsB - Number of columns in matrixB.
 * @param {WebAssembly.Instance} wasmInstance - The WebAssembly instance.
 * @returns {Float32Array} The resulting matrix (flattened row-major).
 */
export function matrixMultiply(matrixA, matrixB, rowsA, colsA, colsB, wasmInstance) {
  if (matrixA.length !== rowsA * colsA || matrixB.length !== colsA * colsB) {
    throw new Error("Invalid matrix dimensions for multiplication.");
  }

  const result = new Float32Array(rowsA * colsB);

  const wasmExports = wasmInstance.exports;
  const memory = wasmExports.memory;

  const memoryBuffer = new Float32Array(memory.buffer);

  // Allocate memory for matrices in WASM memory
  const offsetA = 0;
  const offsetB = offsetA + matrixA.length;
  const offsetResult = offsetB + matrixB.length;

  memoryBuffer.set(matrixA, offsetA);
  memoryBuffer.set(matrixB, offsetB);

  // Perform matrix multiplication using WASM
  wasmExports.mul(offsetA, offsetB, offsetResult, rowsA, colsA, colsB);

  // Copy result back to JS
  result.set(memoryBuffer.subarray(offsetResult, offsetResult + result.length));

  return result;
}

