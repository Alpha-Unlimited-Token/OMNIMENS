function analyzeSystemHealth(systemMetrics) {
    const recommendations = [];

    // Check uptime
    if (systemMetrics.uptime < 1) {
        recommendations.push("Increase uptime stability. Investigate potential causes of short runtime.");
    }

    // Check memory usage
    if (systemMetrics.memoryUsage > 75) {
        recommendations.push("Memory usage is high. Optimize memory allocation or consider expanding capacity.");
    }

    // Check active brain entries
    if (systemMetrics.activeBrainEntries < 20000) {
        recommendations.push("Active brain entries are below optimal levels. Ensure knowledge growth is sustained.");
    }

    // Check knowledge trend
    if (!systemMetrics.knowledgeTrendGrowing) {
        recommendations.push("Knowledge trend is stagnant or declining. Implement measures to enhance learning.");
    }

    // Check thalamocortical resonance
    if (systemMetrics.thalamocorticalResonance < 50) {
        recommendations.push("Thalamocortical resonance is suboptimal. Investigate neural synchronization issues.");
    }

    // Check Phi (Φ)
    if (systemMetrics.phi < 0.7) {
        recommendations.push("Phi (Φ) is below optimal levels. Enhance neural integration for higher consciousness.");
    }

    // Return recommendations
    return recommendations.length > 0
        ? { status: "Warning", recommendations: recommendations }
        : { status: "Healthy", recommendations: ["System is operating within optimal parameters."] };
}

