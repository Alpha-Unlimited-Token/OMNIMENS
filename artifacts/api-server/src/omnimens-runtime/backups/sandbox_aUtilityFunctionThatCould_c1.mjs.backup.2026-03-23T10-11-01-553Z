function extractEntitiesFromText(text, patterns) {
    const results = [];
    patterns.forEach(pattern => {
        const regex = new RegExp(pattern, 'g');
        let match;
        while ((match = regex.exec(text)) !== null) {
            results.push({
                match: match[0],
                index: match.index,
                pattern: pattern
            });
        }
    });
    return results;
}

