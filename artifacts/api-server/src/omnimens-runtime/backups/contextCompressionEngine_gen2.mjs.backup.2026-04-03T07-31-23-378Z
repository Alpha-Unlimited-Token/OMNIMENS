// contextCompressionEngine.mjs

import { createHash } from 'crypto';

/**
 * Generate a compact summary of a text using a simple transformer-inspired approach.
 * @param {string} text - The input text to summarize.
 * @param {number} maxLength - Maximum length of the summary.
 * @returns {string} - A compact summary of the input text.
 */
export function summarizeText(text, maxLength) {
  if (typeof text !== 'string' || text.length === 0) {
    throw new Error('Input text must be a non-empty string.');
  }
  if (typeof maxLength !== 'number' || maxLength <= 0) {
    throw new Error('maxLength must be a positive number.');
  }

  const sentences = text.split('.').map(s => s.trim()).filter(s => s.length > 0);
  sentences.sort((a, b) => b.length - a.length); // Prioritize longer sentences for more context.

  let summary = '';
  for (const sentence of sentences) {
    if ((summary + sentence).length <= maxLength) {
      summary += (summary ? ' ' : '') + sentence;
    } else {
      break;
    }
  }

  return summary || text.slice(0, maxLength); // Fallback to truncating if no sentences fit.
}

/**
 * Generate a fixed-size vector embedding for a given text using a hash-based approach.
 * @param {string} text - The input text to embed.
 * @param {number} dimensions - The size of the output vector.
 * @returns {number[]} - A fixed-size numerical vector embedding.
 */
export function generateEmbedding(text, dimensions) {
  if (typeof text !== 'string' || text.length === 0) {
    throw new Error('Input text must be a non-empty string.');
  }
  if (typeof dimensions !== 'number' || dimensions <= 0) {
    throw new Error('dimensions must be a positive number.');
  }

  const hash = createHash('sha256').update(text).digest('hex');
  const embedding = new Array(dimensions).fill(0);

  for (let i = 0; i < hash.length; i++) {
    const charCode = hash.charCodeAt(i);
    embedding[i % dimensions] += charCode;
  }

  // Normalize the embedding to have unit length.
  const magnitude = Math.sqrt(embedding.reduce((sum, val) => sum + val ** 2, 0));
  return embedding.map(val => val / magnitude);
}

/**
 * Perform dimensionality reduction on a vector using a simple PCA-inspired approach.
 * @param {number[][]} vectors - Array of input vectors.
 * @param {number} targetDimensions - Number of dimensions to reduce to.
 * @returns {number[][]} - Reduced-dimensionality vectors.
 */
export function reduceDimensions(vectors, targetDimensions) {
  if (!Array.isArray(vectors) || vectors.length === 0 || !Array.isArray(vectors[0])) {
    throw new Error('Input must be a non-empty array of vectors.');
  }
  if (typeof targetDimensions !== 'number' || targetDimensions <= 0) {
    throw new Error('targetDimensions must be a positive number.');
  }

  const originalDimensions = vectors[0].length;
  if (targetDimensions >= originalDimensions) {
    throw new Error('targetDimensions must be less than the original dimensions.');
  }

  // Compute the mean vector.
  const meanVector = new Array(originalDimensions).fill(0);
  for (const vector of vectors) {
    for (let i = 0; i < originalDimensions; i++) {
      meanVector[i] += vector[i];
    }
  }
  for (let i = 0; i < originalDimensions; i++) {
    meanVector[i] /= vectors.length;
  }

  // Center the vectors.
  const centeredVectors = vectors.map(vector => vector.map((val, i) => val - meanVector[i]));

  // Compute covariance matrix (simplified for diagonal dominance).
  const covariance = new Array(originalDimensions).fill(0).map(() => new Array(originalDimensions).fill(0));
  for (const vector of centeredVectors) {
    for (let i = 0; i < originalDimensions; i++) {
      for (let j = 0; j < originalDimensions; j++) {
        covariance[i][j] += vector[i] * vector[j];
      }
    }
  }

  // Extract the top targetDimensions eigenvectors (simplified as diagonal sort).
  const eigenvalues = covariance.map((row, i) => row[i]);
  const sortedIndices = eigenvalues.map((val, i) => i).sort((a, b) => eigenvalues[b] - eigenvalues[a]);
  const topIndices = sortedIndices.slice(0, targetDimensions);

  // Project vectors onto the top eigenvectors.
  return centeredVectors.map(vector => topIndices.map(i => vector[i]));
}

/**
 * Compactly summarize and embed input text for long-term memory storage.
 * @param {string} text - The input text to process.
 * @param {number} summaryLength - Desired length of the summary.
 * @param {number} embeddingDimensions - Desired size of the embedding vector.
 * @returns {{ summary, embedding}} - Summary and embedding.
 */
export function compressContext(text, summaryLength, embeddingDimensions) {
  const summary = summarizeText(text, summaryLength);
  const embedding = generateEmbedding(summary, embeddingDimensions);
  return { summary, embedding };
}