// Optimized data structure for fast associative memory lookup
function AssociativeMemory() {
    this.store = new Map();
}

AssociativeMemory.prototype.set = function(key, value) {
    this.store.set(key, value);
};

AssociativeMemory.prototype.get = function(key) {
    return this.store.has(key) ? this.store.get(key) : null;
};

AssociativeMemory.prototype.has = function(key) {
    return this.store.has(key);
};

AssociativeMemory.prototype.delete = function(key) {
    return this.store.delete(key);
};

AssociativeMemory.prototype.clear = function() {
    this.store.clear();
};

AssociativeMemory.prototype.size = function() {
    return this.store.size;
};

// Self-tests
(function testAssociativeMemory() {
    const memory = new AssociativeMemory();

    // Test 1: Basic set and get
    memory.set("name", "Alice");
    console.log(memory.get("name") === "Alice"); // true

    // Test 2: Check existence of a key
    console.log(memory.has("name") === true); // true
    console.log(memory.has("age") === false); // true

    // Test 3: Delete a key
    memory.set("age", 25);
    console.log(memory.get("age") === 25); // true
    memory.delete("age");
    console.log(memory.has("age") === false); // true

    // Test 4: Clear all keys
    memory.set("city", "New York");
    memory.set("country", "USA");
    console.log(memory.size() === 2); // true
    memory.clear();
    console.log(memory.size() === 0); // true

    // Test 5: Handle non-existent keys
    console.log(memory.get("nonexistent") === null); // true

    console.log("All tests passed.");
})();