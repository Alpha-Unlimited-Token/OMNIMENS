function createKnowledgeGraph() {
    // Knowledge graph structure
    const graph = new Map();

    // Add a concept to the graph with connections
    function addConcept(concept, connections = []) {
        if (!graph.has(concept)) {
            graph.set(concept, new Set());
        }
        connections.forEach(conn => {
            if (!graph.has(conn)) {
                graph.set(conn, new Set());
            }
            graph.get(concept).add(conn);
            graph.get(conn).add(concept); // Make connections bidirectional
        });
    }

    // Retrieve related concepts using breadth-first search
    function retrieveRelatedConcepts(startConcept, maxDepth = 2) {
        if (!graph.has(startConcept)) return [];
        const visited = new Set();
        const queue = [{ concept: startConcept, depth: 0 }];
        const results = [];

        while (queue.length > 0) {
            const { concept, depth } = queue.shift();
            if (visited.has(concept) || depth > maxDepth) continue;
            visited.add(concept);
            results.push(concept);

            graph.get(concept).forEach(neighbor => {
                if (!visited.has(neighbor)) {
                    queue.push({ concept: neighbor, depth: depth + 1 });
                }
            });
        }

        return results;
    }

    // Pattern recognition: Find shortest path between two concepts
    function findShortestPath(startConcept, endConcept) {
        if (!graph.has(startConcept) || !graph.has(endConcept)) return null;
        const visited = new Set();
        const queue = [{ concept: startConcept, path: [startConcept] }];

        while (queue.length > 0) {
            const { concept, path } = queue.shift();
            if (concept === endConcept) return path;
            if (visited.has(concept)) continue;
            visited.add(concept);

            graph.get(concept).forEach(neighbor => {
                if (!visited.has(neighbor)) {
                    queue.push({ concept: neighbor, path: [...path, neighbor] });
                }
            });
        }

        return null; // No path found
    }

    return { addConcept, retrieveRelatedConcepts, findShortestPath };
}

