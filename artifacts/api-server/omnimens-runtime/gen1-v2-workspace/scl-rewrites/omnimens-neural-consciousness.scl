·n.v = V_PEAK;
⚡→│n.fired = true;
·n.ref = TAU_REF;
⚡→│fired++;
⚡→│spikePostFiring(n);
·} else {
⚡→│n.fired = false;
⟛│n.v = Math.max(V_REST, n.v);
·}
·n.ic = 0; // reset current each step
·});
⚡→│r.firingRate = fired / r.neurons.length;
·r.activation = 0.8 * r.activation + 0.2 * r.firingRate;
·}
}⟨/stepRegion⟩
