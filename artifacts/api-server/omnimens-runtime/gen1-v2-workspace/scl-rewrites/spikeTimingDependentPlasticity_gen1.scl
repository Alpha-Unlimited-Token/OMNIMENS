⊩│export function applySTDP(preSynapticSpike, postSynapticSpike, weight) {
·const deltaTime = postSynapticSpike.timestamp - preSynapticSpike.timestamp;
·const learningRate = 0.01;
·if (deltaTime > 0) {
·weight += learningRate * Math.exp(-deltaTime);
·} else {
·weight -= learningRate * Math.exp(deltaTime);
·}
⊷│return weight;
·}
}⟨/applySTDP⟩
