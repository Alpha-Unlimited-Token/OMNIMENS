⊩│export function selectiveMultiBranchEvaluation(task, branches, scoringFn) {
·const branchScores = branches.map(branch => {
·const score = scoringFn(branch);
⊷│return { branch, score };
·});
·branchScores.sort((a, b) => b.score - a.score);
·const selectedBranch = branchScores[0];
·const topBranches = branchScores.slice(0, Math.ceil(branches.length * 0.3));
⋐│const avgTopScore = topBranches.reduce((s, b) => s + b.score, 0) / topBranches.length;
⊷│return {
·selected: selectedBranch,
·topBranches,
·avgTopScore,
·totalEvaluated: branches.length,
·confidence: selectedBranch.score / (avgTopScore || 1)
·};
·}
}⟨/selectiveMultiBranchEvaluation⟩
