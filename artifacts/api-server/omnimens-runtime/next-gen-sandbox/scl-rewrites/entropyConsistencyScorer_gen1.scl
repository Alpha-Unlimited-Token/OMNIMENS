⊩calculateEntropy(1)→void⟨3⟩{
⊩│export function calculateEntropy(probabilities) {
⋐│return -probabilities.reduce((sum, p) => sum + (p > 0 ? p * Math.log2(p) : 0), 0);
·}
}⟨/calculateEntropy⟩
⊩scoreReasoningChain(1)→void⟨5⟩{
⊩│export function scoreReasoningChain(chain) {
·const probabilities = chain.map(step => step.probability);
·const entropy = calculateEntropy(probabilities);
⊷│return 1 / (1 + entropy); // Higher score for lower entropy
·}
}⟨/scoreReasoningChain⟩
