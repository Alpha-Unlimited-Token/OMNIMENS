·export function* chunkTask(taskFunction, initialState, chunkSize) {
·let currentState = { ...initialState };
·let progress = 0;
·while (progress < chunkSize) {
·currentState = taskFunction(currentState);
·progress++;
·yield { progress, state: currentState };
·}
·}
