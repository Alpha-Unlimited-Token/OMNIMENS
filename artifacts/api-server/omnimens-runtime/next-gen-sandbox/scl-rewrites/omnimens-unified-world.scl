·targetSkill,
·difficulty: difficulty * (0.8 + Math.random() * 0.4),
⊰│successCriteria: `⊣ ${challengeType.replace(/_/g, " ")} with ≥${Math.floor(60 + difficulty * 20)}% proficiency, no safety violations, within time ⏳`,
·timeLimit_s: Math.floor(60 + (1 - difficulty) * 240),
·bonusObjectives: [
