⊩│export async function recursiveContextLoader(database, query, keywords, maxDepth = 3, currentDepth = 0) {
·if (currentDepth >= maxDepth) {
⊷│return '';
·}
⊻│const contextChunks = database.filter(entry => entry.includes(query));
