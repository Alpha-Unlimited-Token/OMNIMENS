⊴│const deeperSummary = await recursiveContextLoader(database, query, nextKeywords, maxDepth, currentDepth + 1);
⊷│return summarizeContext(combinedSummary + ' ' + deeperSummary, keywords);
·}
}⟨/recursiveContextLoader⟩
