·regionDetails[regionName] = {
·populationCount: popIds.length,
·totalNeurons,
⊳│avgFiringRate: popIds.length > 0 ? totalFiring / popIds.leng
⊳│avgCorrelation: popIds.length > 0 ? totalCorrelation / popId
·totalDendrites,
·totalSpines,
·};
·}
