⊰│return parts.length > 1 ? `${prefix}-${parts[1]}` : `${prefix}-${Math.abs(seed % 1000)}`;
·}),
·bridgeFidelity: tv.bridgeFidelity * 0.85,
·};
·}
}⟨/forkForGen2⟩
