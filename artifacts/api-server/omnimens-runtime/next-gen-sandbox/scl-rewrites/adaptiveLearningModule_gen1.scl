⊩│export function simulateEnvironment(α, episodes, rewardFunction, transitionFunction) {
·const cumulativeRewards = [];
·for (let episode = 0; episode < episodes; episode++) {
·let state = 0; // Assume initial state is always 0
·let totalReward = 0;
·while (true) {
const action = α.chooseAction(state);
·const reward = rewardFunction(state, action);
·const nextState = transitionFunction(state, action);
α.updateQValues(state, action, reward, nextState);
·totalReward += reward;
if (nextState === null) break; // End of episode ∨
·state = nextState;
·}
⊺│cumulativeRewards.push(totalReward);
·}
⊷│return cumulativeRewards;
·}
}⟨/simulateEnvironment⟩
