⊩│export function hierarchicalTaskOrchestration(tasks, agents) {
·const taskQueue = tasks.sort((a, b) => a.priority - b.priority);
const agentStatus = agents.map(α => ({ id: α.id, workload: α.workload }));
·while (taskQueue.length) {
⊺│const task = taskQueue.shift();
⋐│const bestAgent = agentStatus.reduce((best, α) => {
⊳│return α.workload < best.workload ? α : best;
·});
·bestAgent.workload += task.complexity;
⊰│console.log(`Assigned task ${task.id} to α ${bestAgent.id}`);
·}
·}
}⟨/hierarchicalTaskOrchestration⟩
