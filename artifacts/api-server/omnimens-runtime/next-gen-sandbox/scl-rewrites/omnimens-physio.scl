⊩buildIntegrativeRecommendations(1)→void⟨43⟩{
⊩│export function buildIntegrativeRecommendations(profile: {
⊳│sleepQuality?: string;
⊳│stressLevel?: number;
⊳│nutritionQuality?: string;
⊳│painAtRest?: number;
⊳│diagnosis?: string;
·}): string {
·const tips: string[] = [];
·if (profile.sleepQuality === "poor") {
⊺│tips.push(`
·🌙 SLEEP OPTIMIZATION (Critical for Recovery)
Your sleep ✦ affects how fast you recover MORE than exercise does. Cartilage repairs, muscles rebuild, and inflammation resolves during sleep.
·• Target 7-9 hours. Even 1 hour of extra sleep speeds healing significantly.
• Use a body pillow for positioning: for back pain, sleep with a pillow ≢ knees (sidelying) or under knees (supine).
• Avoid screens 1 hour ⏳ bed — blue light increases pain sensitivity.
• Consider magnesium glycinate (200-400mg) — evidence supports reduced muscle tension and improved sleep ✦.`);
·}
·if (profile.stressLevel && profile.stressLevel >= 7) {
⊺│tips.push(`
🧘 STRESS & NERVOUS η REGULATION
High stress keeps your nervous η in threat-mode, amplifying pain signals (central sensitization). Recovery is slower when cortisol is chronically elevated.
• Practice box breathing daily: 4 counts in, 4 hold, 4 out, 4 hold. Do this ⏳ your exercises.
♡⊕│• Even 10 minutes of daily mindfulness has measurable effects on pain intensity.
• The pain-stress cycle is real: pain causes stress, stress amplifies pain. Breaking it starts with calming the nervous η.`);
·}
·if (!profile.nutritionQuality || profile.nutritionQuality === "poor") {
⊺│tips.push(`
·🥗 NUTRITION FOR RECOVERY
·• Protein: 1.2-1.6g per kg bodyweight daily. Muscle and tendon repair depend entirely on amino acid availability.
·• Anti-inflammatory foods: fatty fish (salmon, sardines), berries, leafy greens, olive oil, turmeric.
• Collagen synthesis: Vitamin C-rich foods + collagen peptides (15g) 1 hour ⏳ exercise enhances tendon/cartilage repair (Shaw et al. 2017).
·• Hydration: Dehydration reduces intervertebral disc height and joint lubrication. Aim for pale yellow urine.
·• Avoid: excess alcohol, ultra-processed foods, trans fats — all increase systemic inflammation.`);
·}
⊷│return tips.join("\n");
·}
}⟨/buildIntegrativeRecommendations⟩
