⊩calculateEntropy(1)→void⟨3⟩{
⊩│export function calculateEntropy(probabilities) {
⋐│return probabilities.reduce((acc, p) => acc - p * Math.log2(p), 0);
·}
}⟨/calculateEntropy⟩
⊩dynamicConfidenceAdjustment(1)→void⟨7⟩{
⊩│export function dynamicConfidenceAdjustment(reasoningChains) {
⊷│return reasoningChains.map(chain => {
·const entropy = calculateEntropy(chain.probabilities);
·chain.confidence = 1 / (1 + entropy);
⊷│return chain;
·});
·}
}⟨/dynamicConfidenceAdjustment⟩
