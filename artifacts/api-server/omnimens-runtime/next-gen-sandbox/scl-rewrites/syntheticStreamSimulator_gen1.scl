·const score = calculateRecencyScore(dataPoint.timestamp, currentTime);
⊺│streams[streamId].push({ ...dataPoint, score });
·}
·streams[streamId] = summarizeData(streams[streamId], summarizationFunction);
·}
⊷│return streams;
·}
}⟨/simulateStream⟩
