⊩│export function summarizeContext(chunks, maxChunkSize = 500) {
·if (!Array.isArray(chunks)) {
⊵│throw new TypeError('Input must be an array of strings.');
·}
⊹│if (chunks.length === 0) {
⊷│return '';
