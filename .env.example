NODE_ENV=production
PORT=8080

# PostgreSQL — Railway provides this automatically when you add a Postgres plugin
DATABASE_URL=postgresql://user:password@host:5432/dbname

# OpenAI — get from platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Stripe — get from dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...

# Stripe price IDs — get from dashboard.stripe.com/prices (use live mode prices)
STRIPE_PRICE_SEEKER=price_...
STRIPE_PRICE_ORACLE=price_...
STRIPE_PRICE_SOVEREIGN=price_...

# Replit Auth — keep these from your Replit project settings
REPL_ID=your-repl-id
REPL_OWNER_ID=50777126
REPL_OWNER=alphaunlimitedt

# Your Railway domain — e.g. godflesh.up.railway.app
REPLIT_DOMAINS=godflesh.up.railway.app
