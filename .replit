modules = ["nodejs-24", "postgresql-16", "python-3.11"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["stripe:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["blender", "ffmpeg-full", "fontconfig", "freetype", "gdk-pixbuf", "geos", "gtk2-x11", "lcms2", "libGL", "libGLU", "libimagequant", "libjpeg", "libpulseaudio", "libtiff", "libwebp", "libxcrypt", "oneDNN", "openal", "openjpeg", "openscad", "pkg-config", "re2", "tcl", "tk", "unzip", "xsimd", "zlib"]

[userenv]

